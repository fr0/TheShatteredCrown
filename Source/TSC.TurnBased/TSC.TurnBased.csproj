<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Kept in step with the main csproj by hand for now; the assembly is
         internal to this mod (stage one of the turn-engine split). -->
    <Version>1.0.5</Version>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- SAME root namespace as the main assembly, on purpose: Scribe and
         GenTypes resolve saved components and XML classes by namespace-
         qualified name, assembly-agnostic. Keeping the namespace is what
         makes this split invisible to existing saves. -->
    <RootNamespace>TheShatteredCrown</RootNamespace>
    <!-- The 0 prefix is load-bearing: RimWorld loads a mod's assemblies in
         file-name order, and this one must be in the AppDomain before
         TheShatteredCrown.dll (which references it) resolves. Same
         convention as 0Harmony. -->
    <AssemblyName>0TSC.TurnBased</AssemblyName>
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony" Version="2.*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
