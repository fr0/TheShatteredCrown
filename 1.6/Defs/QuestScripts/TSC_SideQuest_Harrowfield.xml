<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Act 1 epilogue: given automatically when Oswin's rites conclude
       (TSC_Act1_Ettersnap's TSC_RitesPerformed path). The ettersnap's
       vision pointed past Harrowfield; the company breaks camp for the
       village while the player rides ahead. Spawns the Harrowfield site
       (this quest is what brings the village into play) and succeeds
       shortly after the player visits. -->
  <QuestScriptDef>
    <defName>TSC_SideQuest_Harrowfield</defName>
    <isRootSpecial>true</isRootSpecial>
    <randomlySelectable>false</randomlySelectable>
    <rootMinPoints>0</rootMinPoints>
    <autoAccept>true</autoAccept>
    <questNameRules>
      <rulesStrings>
        <li>questName->The Road to Harrowfield</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->The ettersnap's vision showed a waterfall-fed lake, and Oswin knows the water: it lies in the hills beyond Harrowfield, a farming village half a day off the old road. Stone cottages, three potato farms, a smithy, and an elder who remembers more than he tells.\n\nSerra and Oswin are breaking camp to follow. Ride ahead: visit Harrowfield, talk to the locals, and don't spook them. The company will likely need their goodwill before this is done.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_GetMap">
          <canBeSpace>false</canBeSpace>
        </li>

        <li Class="QuestNode_Set">
          <name>siteDistRange</name>
          <value>4~12</value>
        </li>

        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>

        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>TSC_HarrowfieldVillage</tag>
            </li>
          </sitePartsTags>
        </li>

        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>

        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>

        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.MapGenerated</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <letterDef>PositiveEvent</letterDef>
                <label TKey="LetterLabelHarrowfield">Harrowfield</label>
                <text TKey="LetterTextHarrowfield">Harrowfield, at last. Cookfire smoke over every chimney, and the steady ring of Haldor's hammer to welcome you in.\n\nThe villagers will talk, if you take the time. (Select a colonist and right-click a villager to speak with them.)</text>
              </li>
              <li Class="TheShatteredCrown.QuestNode_TSC_GrantXp">
                <xp>150</xp>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Delay">
          <inSignalEnable>site.MapGenerated</inSignalEnable>
          <delayTicks>60000</delayTicks>
          <node Class="QuestNode_End">
            <outcome>Success</outcome>
          </node>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
