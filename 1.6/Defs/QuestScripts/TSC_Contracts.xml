<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ================================================================
       Adventure Mode contracts: procedurally generated guild work.
       Generated by TSC_ContractManager (never by the storyteller), with
       threat points scaled to the party's adventuring levels. These are
       OFFERS: autoAccept false, the player picks from the quest tab, and
       an un-taken contract expires off the board on its own.
       Naming: multiple rulesStrings for one keyword = random pick, so
       every contract of a template reads a little differently.
       ================================================================ -->

  <QuestScriptDef Name="TSC_ContractBase" Abstract="True">
    <isRootSpecial>true</isRootSpecial>
    <randomlySelectable>false</randomlySelectable>
    <rootMinPoints>0</rootMinPoints>
    <autoAccept>false</autoAccept>
    <expireDaysRange>5~9</expireDaysRange>
    <nameMustBeUnique>false</nameMustBeUnique>
  </QuestScriptDef>

  <!-- ============ Contract: clear a bandit camp ============ -->

  <QuestScriptDef ParentName="TSC_ContractBase">
    <defName>TSC_Contract_BanditCamp</defName>
    <defaultChallengeRating>2</defaultChallengeRating>
    <questNameRules>
      <rulesStrings>
        <li>questName->Contract: [bc_name]</li>
        <li>bc_name->Rats on the Road</li>
        <li>bc_name->The Toll Collectors</li>
        <li>bc_name->Smoke on the Ridge</li>
        <li>bc_name->No More Tribute</li>
        <li>bc_name->The Low Company</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[bc_flavor]\n\nThe camp is marked on your map. Clear it out. Pay is charter silver and guild coin when the last of them is down.</li>
        <li>bc_flavor->A bandit crew has set up on a road the guild's couriers use. They are charging for passage, and not only in coin.</li>
        <li>bc_flavor->Farmsteads in the marked hills have gone quiet, one after another. The guild traced it to a camp.</li>
        <li>bc_flavor->A guild caravan was taken whole - goods, animals and two drivers. The trail ends at a fortified camp.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_SubScript">
          <def>Util_AdjustPointsForDistantFight</def>
        </li>
        <li Class="QuestNode_GetMap">
          <canBeSpace>false</canBeSpace>
        </li>
        <li Class="QuestNode_Set">
          <name>siteDistRange</name>
          <value>3~12</value>
        </li>
        <li Class="QuestNode_GetSiteTile">
          <selectLandmarkChance>0</selectLandmarkChance>
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>BanditCamp</tag>
            </li>
          </sitePartsTags>
        </li>
        <!-- Medieval-only defenders: brigands, archers, hexers, never guns -->
        <li Class="TheShatteredCrown.QuestNode_TSC_GetBanditFaction">
          <storeAs>siteFaction</storeAs>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>
        <li Class="TheShatteredCrown.QuestNode_TSC_RequireSite" />
        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.Destroyed</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelContractLost">Contract lapsed: [resolvedQuestName]</label>
                <text TKey="LetterTextContractLost">The camp scattered before the job was done. The guild strikes the contract. No payment, no penalty.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.AllEnemiesDefeated</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Notify_PlayerRaidedSomeone">
                <getRaidersFromMapParent>$site</getRaidersFromMapParent>
              </li>
              <li Class="QuestNode_Letter">
                <letterDef>PositiveEvent</letterDef>
                <label TKey="LetterLabelContractDone">Contract complete</label>
                <text TKey="LetterTextContractDone">The camp is cleared and the road is open. The guild pays as chartered.</text>
              </li>
              <li Class="TheShatteredCrown.QuestNode_TSC_GrantXp">
                <xp>200</xp>
              </li>
              <li Class="TheShatteredCrown.QuestNode_TSC_GiveSilver">
                <amount>350</amount>
                <coins>4</coins>
              </li>
            </nodes>
          </node>
        </li>
        <li Class="QuestNode_End">
          <inSignal>site.AllEnemiesDefeated</inSignal>
          <outcome>Success</outcome>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

  <!-- ============ Contract: delve a ruin for the strongbox ============ -->

  <QuestScriptDef ParentName="TSC_ContractBase">
    <defName>TSC_Contract_Delve</defName>
    <defaultChallengeRating>2</defaultChallengeRating>
    <questNameRules>
      <rulesStrings>
        <li>questName->Contract: [dv_name]</li>
        <li>dv_name->The Written-Off Box</li>
        <li>dv_name->Under the Fallen Roof</li>
        <li>dv_name->The Courier's Last Stop</li>
        <li>dv_name->Old Iron, Old Debts</li>
        <li>dv_name->What the Road Kept</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[dv_flavor]\n\nThe ruin is marked on your map. Find the guild's strongbox, carry it out, and bring it to a guild hall - the guild pays on delivery, not on recovery. Anything else you find is yours. Pay is charter silver and guild coin.</li>
        <li>dv_flavor->A guild courier sheltered from a storm in an old roadside ruin and never came out. The ledger still lists his strongbox as undelivered.</li>
        <li>dv_flavor->A ruin-diver sold the guild a map. He says he saw the Wayfarers' seal under a collapsed floor and left it there because the floor was still coming down.</li>
        <li>dv_flavor->The guild has bought back this strongbox twice. The third thief never got out of the ruin he hid it in. The box is still down there, and so is whatever stopped him.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_GetMap">
          <canBeSpace>false</canBeSpace>
        </li>
        <li Class="QuestNode_Set">
          <name>siteDistRange</name>
          <value>3~12</value>
        </li>
        <li Class="QuestNode_GetSiteTile">
          <selectLandmarkChance>0</selectLandmarkChance>
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>TSC_ContractRuin</tag>
            </li>
          </sitePartsTags>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>
        <li Class="TheShatteredCrown.QuestNode_TSC_RequireSite" />
        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>

        <!-- Leaving the ruin only LAPSES the contract if the strongbox is
             still in it. Carrying it out through the reform-caravan UI
             destroys the site instantly, which used to fail the job the
             player had just finished. -->
        <li Class="TheShatteredCrown.QuestNode_TSC_FailUnlessHolding">
          <inSignal>site.Destroyed</inSignal>
          <item>TSC_GuildStrongbox</item>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelDelveLost">Contract lapsed: [resolvedQuestName]</label>
                <text TKey="LetterTextDelveLost">The delve was abandoned with the strongbox still under the ruin. The guild strikes the contract and marks the box undelivered.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="TheShatteredCrown.QuestNode_TSC_DetectItem">
          <item>TSC_GuildStrongbox</item>
          <deliverToGuild>true</deliverToGuild>
          <node Class="QuestNode_Sequence">
            <nodes>
              <!-- The guild COLLECTS the box: paying for its return means it
                   leaves your bags, or the next delve contract would complete
                   the moment it was accepted. -->
              <li Class="TheShatteredCrown.QuestNode_TSC_TakeItem">
                <item>TSC_GuildStrongbox</item>
                <count>1</count>
              </li>
              <li Class="QuestNode_Letter">
                <letterDef>PositiveEvent</letterDef>
                <label TKey="LetterLabelDelveDone">Contract complete</label>
                <text TKey="LetterTextDelveDone">The strongbox is back under guild seal. Payment as chartered.</text>
              </li>
              <li Class="TheShatteredCrown.QuestNode_TSC_GrantXp">
                <xp>200</xp>
              </li>
              <li Class="TheShatteredCrown.QuestNode_TSC_GiveSilver">
                <amount>400</amount>
                <coins>5</coins>
              </li>
              <li Class="QuestNode_End">
                <outcome>Success</outcome>
              </li>
            </nodes>
          </node>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

  <!-- ============ Contract: deep delve (three floors) ============ -->

  <QuestScriptDef ParentName="TSC_ContractBase">
    <defName>TSC_Contract_DeepDelve</defName>
    <defaultChallengeRating>3</defaultChallengeRating>
    <questNameRules>
      <rulesStrings>
        <li>questName->Contract: [dd_name]</li>
        <li>dd_name->Three Floors Down</li>
        <li>dd_name->The Deep Works</li>
        <li>dd_name->What the Road Left</li>
        <li>dd_name->The Undercount</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[dd_flavor]\n\nNobody agrees how far down the works go. Something has taken every floor since they were abandoned, and the guild's surveyor did not stay to find out what.\n\nThe coffer is on the lowest floor. Bring it up and take it to a guild hall. The guild pays the premium rate on delivery, in silver and coin.</li>
        <li>dd_flavor->An old roadside ruin sits on works that go down further than the ruin is wide. The guild lost a coffer in them and has been embarrassed about it since.</li>
        <li>dd_flavor->The last crew the guild sent down came back one short and would not go again for triple pay. Their report is one line: it is not the same floor twice.</li>
        <li>dd_flavor->The works were a staging depot before the war. That means a strongroom, and the guild wants it opened before somebody else works that out.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_GetMap">
          <canBeSpace>false</canBeSpace>
        </li>
        <li Class="QuestNode_Set">
          <name>siteDistRange</name>
          <value>4~14</value>
        </li>
        <li Class="QuestNode_GetSiteTile">
          <selectLandmarkChance>0</selectLandmarkChance>
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>TSC_ContractDeepDelve</tag>
            </li>
          </sitePartsTags>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>
        <li Class="TheShatteredCrown.QuestNode_TSC_RequireSite" />
        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>

        <li Class="TheShatteredCrown.QuestNode_TSC_FailUnlessHolding">
          <inSignal>site.Destroyed</inSignal>
          <item>TSC_GuildStrongbox</item>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelDeepDelveLost">Contract lapsed: [resolvedQuestName]</label>
                <text TKey="LetterTextDeepDelveLost">The delve was abandoned with the coffer still on the bottom floor. The guild strikes the contract.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="TheShatteredCrown.QuestNode_TSC_DetectItem">
          <item>TSC_GuildStrongbox</item>
          <deliverToGuild>true</deliverToGuild>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="TheShatteredCrown.QuestNode_TSC_TakeItem">
                <item>TSC_GuildStrongbox</item>
                <count>1</count>
              </li>
              <li Class="QuestNode_Letter">
                <letterDef>PositiveEvent</letterDef>
                <label TKey="LetterLabelDeepDelveDone">Contract complete</label>
                <text TKey="LetterTextDeepDelveDone">The coffer is on the factor's table. The guild pays the premium rate.</text>
              </li>
              <li Class="TheShatteredCrown.QuestNode_TSC_GrantXp">
                <xp>350</xp>
              </li>
              <li Class="TheShatteredCrown.QuestNode_TSC_GiveSilver">
                <amount>600</amount>
                <coins>8</coins>
              </li>
              <li Class="QuestNode_End">
                <outcome>Success</outcome>
              </li>
            </nodes>
          </node>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

  <!-- ============ Contract: hunt a beast ============ -->

  <QuestScriptDef ParentName="TSC_ContractBase">
    <defName>TSC_Contract_Hunt</defName>
    <defaultChallengeRating>1</defaultChallengeRating>
    <questNameRules>
      <rulesStrings>
        <li>questName->Contract: [beastName]</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[ht_flavor]\n\nThe locals call it [beastName].\n\nIts den is marked on your map. Go in and finish it. The guild pays on proof of the kill, in silver and coin.</li>
        <li>ht_flavor->Something has been taking livestock in the marked hills. Last month it started taking people. The locals pooled a bounty and the guild matched it.</li>
        <li>ht_flavor->A beast has denned beside a droving road and learned that drovers are slower than sheep. The guild wants the road back.</li>
        <li>ht_flavor->Hunters went after it and came back fewer. The bounty doubled. The guild is done waiting.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_GetMap">
          <canBeSpace>false</canBeSpace>
        </li>
        <li Class="QuestNode_Set">
          <name>siteDistRange</name>
          <value>3~10</value>
        </li>
        <li Class="QuestNode_GetSiteTile">
          <selectLandmarkChance>0</selectLandmarkChance>
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>TSC_ContractDen</tag>
            </li>
          </sitePartsTags>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>
        <li Class="TheShatteredCrown.QuestNode_TSC_RequireSite" />
        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>

        <li Class="TheShatteredCrown.QuestNode_TSC_SpawnAnimalAtSite">
          <inSignal>site.MapGenerated</inSignal>
          <kind>Bear_Grizzly</kind>
          <count>1</count>
          <site>$site</site>
          <tag>prey</tag>
          <!-- Rolled at generation: names the contract AND the animal. -->
          <nameAs>beastName</nameAs>
          <!-- A bountied man-eater comes at you. The contract is to end it,
               not to go looking for a bear that would rather graze. -->
          <manhunter>true</manhunter>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>site.Destroyed</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelHuntLost">Contract lapsed: [resolvedQuestName]</label>
                <text TKey="LetterTextHuntLost">The hunt was abandoned with the beast still alive. The guild strikes the contract. The bounty stands for whoever tries next.</text>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>prey.Killed</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <letterDef>PositiveEvent</letterDef>
                <label TKey="LetterLabelHuntDone">Contract complete</label>
                <text TKey="LetterTextHuntDone">The beast is down. The guild pays the bounty in full, and the hide is yours.</text>
              </li>
              <li Class="TheShatteredCrown.QuestNode_TSC_GrantXp">
                <xp>150</xp>
              </li>
              <li Class="TheShatteredCrown.QuestNode_TSC_GiveSilver">
                <amount>250</amount>
                <coins>3</coins>
              </li>
            </nodes>
          </node>
        </li>
        <li Class="QuestNode_End">
          <inSignal>prey.Killed</inSignal>
          <outcome>Success</outcome>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
