<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============ Watchtower rooms (Chapter 1) ============ -->

  <!-- The garrison's great room: long table, chairs, torchlight -->
  <LayoutRoomDef>
    <defName>TSC_GreatRoom</defName>
    <canMergeWithAdjacentRoom>true</canMergeWithAdjacentRoom>
    <minSingleRectWidth>6</minSingleRectWidth>
    <minSingleRectHeight>6</minSingleRectHeight>
    <floorTypes>
      <li>WoodPlankFloor</li>
    </floorTypes>
    <prefabs>
      <TSC_DiningSet>
        <countPerHundredCells>1</countPerHundredCells>
        <minMaxRange>1~2</minMaxRange>
      </TSC_DiningSet>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>1~3</minMaxRange>
      </TSC_Torch>
    </prefabs>
    <parts>
      <Corpse>0.25</Corpse>
    </parts>
  </LayoutRoomDef>

  <!-- Barracks: wooden bunks along the walls -->
  <LayoutRoomDef>
    <defName>TSC_Barracks</defName>
    <canMergeWithAdjacentRoom>true</canMergeWithAdjacentRoom>
    <floorTypes>
      <li>WoodPlankFloor</li>
    </floorTypes>
    <prefabs>
      <TSC_Bunk>
        <countPerTenEdgeCells>2</countPerTenEdgeCells>
        <minMaxRange>2~6</minMaxRange>
      </TSC_Bunk>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>0~2</minMaxRange>
      </TSC_Torch>
    </prefabs>
    <parts>
      <Corpse>0.2</Corpse>
    </parts>
  </LayoutRoomDef>

  <!-- Storeroom: shelves and a chance of an intact supply cache -->
  <LayoutRoomDef>
    <defName>TSC_Storeroom</defName>
    <canMergeWithAdjacentRoom>true</canMergeWithAdjacentRoom>
    <floorTypes>
      <li>FlagstoneGranite</li>
    </floorTypes>
    <prefabs>
      <TSC_Shelf_Wood>
        <countPerTenEdgeCells>2</countPerTenEdgeCells>
        <minMaxRange>2~8</minMaxRange>
      </TSC_Shelf_Wood>
      <TSC_SupplyCachePrefab>
        <countPerHundredCells>1</countPerHundredCells>
        <minMaxRange>0~2</minMaxRange>
      </TSC_SupplyCachePrefab>
    </prefabs>
    <scatter>
      <WoodLog>
        <groupsPerHundredCells>1~2</groupsPerHundredCells>
        <itemsPerGroup>15~40</itemsPerGroup>
        <groupDistRange>2~4</groupDistRange>
      </WoodLog>
    </scatter>
    <parts>
      <Corpse>0.1</Corpse>
    </parts>
  </LayoutRoomDef>

  <!-- Collapsed chamber: rubble and ruin -->
  <LayoutRoomDef>
    <defName>TSC_RubbleChamber</defName>
    <spawnJunk>false</spawnJunk>
    <scatter>
      <RubblePile>
        <groupsPerHundredCells>2~4</groupsPerHundredCells>
        <itemsPerGroup>2~4</itemsPerGroup>
        <groupDistRange>3~5</groupDistRange>
        <minGroups>1</minGroups>
      </RubblePile>
      <Filth_RubbleRock>
        <groupsPerHundredCells>3~5</groupsPerHundredCells>
        <itemsPerGroup>3~8</itemsPerGroup>
        <groupDistRange>3~5</groupDistRange>
        <minGroups>1</minGroups>
      </Filth_RubbleRock>
    </scatter>
  </LayoutRoomDef>

  <!-- The tower vault: guaranteed once per watchtower, holds the iron-bound chest -->
  <LayoutRoomDef>
    <defName>TSC_Vault</defName>
    <minSingleRectWidth>6</minSingleRectWidth>
    <minSingleRectHeight>6</minSingleRectHeight>
    <floorTypes>
      <li>FlagstoneGranite</li>
    </floorTypes>
    <prefabs>
      <TSC_VaultChest>
        <countRange>1~1</countRange>
      </TSC_VaultChest>
    </prefabs>
    <parts>
      <Corpse>0.3</Corpse>
    </parts>
  </LayoutRoomDef>

  <!-- ============ Monastery rooms (Act 4) ============
       No Corpse parts anywhere: the brothers are all in the ossuary and
       the beds are made. The horror is the tidiness. -->

  <!-- The chapel: altar, pews in rows, candle-dark marble. -->
  <LayoutRoomDef>
    <defName>TSC_MonChapel</defName>
    <minSingleRectWidth>7</minSingleRectWidth>
    <minSingleRectHeight>7</minSingleRectHeight>
    <floorTypes>
      <li>TileMarble</li>
    </floorTypes>
    <prefabs>
      <TSC_AltarNook>
        <countRange>1~1</countRange>
      </TSC_AltarNook>
      <TSC_Pew>
        <countPerHundredCells>4</countPerHundredCells>
        <minMaxRange>2~6</minMaxRange>
      </TSC_Pew>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>1~2</minMaxRange>
      </TSC_Torch>
    </prefabs>
  </LayoutRoomDef>

  <!-- The refectory: long boards set for a meal nobody finished. -->
  <LayoutRoomDef>
    <defName>TSC_Refectory</defName>
    <canMergeWithAdjacentRoom>true</canMergeWithAdjacentRoom>
    <minSingleRectWidth>6</minSingleRectWidth>
    <minSingleRectHeight>6</minSingleRectHeight>
    <floorTypes>
      <li>WoodPlankFloor</li>
    </floorTypes>
    <prefabs>
      <TSC_DiningSet>
        <countPerHundredCells>2</countPerHundredCells>
        <minMaxRange>2~3</minMaxRange>
      </TSC_DiningSet>
      <TSC_Shelf_Wood>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>1~2</minMaxRange>
      </TSC_Shelf_Wood>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>1~2</minMaxRange>
      </TSC_Torch>
    </prefabs>
  </LayoutRoomDef>

  <!-- The dormitory: bunks in rows, every one of them made. -->
  <LayoutRoomDef>
    <defName>TSC_Dormitory</defName>
    <canMergeWithAdjacentRoom>true</canMergeWithAdjacentRoom>
    <floorTypes>
      <li>WoodPlankFloor</li>
    </floorTypes>
    <prefabs>
      <TSC_Bunk>
        <countPerTenEdgeCells>3</countPerTenEdgeCells>
        <minMaxRange>4~10</minMaxRange>
      </TSC_Bunk>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>0~2</minMaxRange>
      </TSC_Torch>
    </prefabs>
  </LayoutRoomDef>

  <!-- The scriptorium: bookcases and copyists' desks. What the house was FOR. -->
  <LayoutRoomDef>
    <defName>TSC_Scriptorium</defName>
    <minSingleRectWidth>6</minSingleRectWidth>
    <minSingleRectHeight>6</minSingleRectHeight>
    <floorTypes>
      <li>WoodPlankFloor</li>
    </floorTypes>
    <prefabs>
      <TSC_BookRow>
        <countPerTenEdgeCells>2</countPerTenEdgeCells>
        <minMaxRange>2~6</minMaxRange>
      </TSC_BookRow>
      <TSC_WritingDesk>
        <countPerHundredCells>3</countPerHundredCells>
        <minMaxRange>2~4</minMaxRange>
      </TSC_WritingDesk>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>1~2</minMaxRange>
      </TSC_Torch>
    </prefabs>
  </LayoutRoomDef>

  <!-- The pantry: shelves inventoried down to nothing, a little hay. -->
  <LayoutRoomDef>
    <defName>TSC_Pantry</defName>
    <canMergeWithAdjacentRoom>true</canMergeWithAdjacentRoom>
    <floorTypes>
      <li>FlagstoneGranite</li>
    </floorTypes>
    <prefabs>
      <TSC_Shelf_Wood>
        <countPerTenEdgeCells>2</countPerTenEdgeCells>
        <minMaxRange>2~8</minMaxRange>
      </TSC_Shelf_Wood>
      <TSC_MonChestPrefab>
        <countPerHundredCells>1</countPerHundredCells>
        <minMaxRange>0~1</minMaxRange>
      </TSC_MonChestPrefab>
    </prefabs>
    <scatter>
      <Hay>
        <groupsPerHundredCells>1~2</groupsPerHundredCells>
        <itemsPerGroup>10~25</itemsPerGroup>
        <groupDistRange>2~4</groupDistRange>
      </Hay>
    </scatter>
  </LayoutRoomDef>

  <!-- ============ Castle rooms (Adventure Mode's ruined fortress) ============ -->

  <!-- The great hall: long boards, torch brackets, and whoever never left -->
  <LayoutRoomDef>
    <defName>TSC_CastleHall</defName>
    <canMergeWithAdjacentRoom>true</canMergeWithAdjacentRoom>
    <minSingleRectWidth>8</minSingleRectWidth>
    <minSingleRectHeight>8</minSingleRectHeight>
    <floorTypes>
      <li>FlagstoneGranite</li>
    </floorTypes>
    <prefabs>
      <TSC_DiningSet>
        <countPerHundredCells>2</countPerHundredCells>
        <minMaxRange>2~3</minMaxRange>
      </TSC_DiningSet>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>2~4</minMaxRange>
      </TSC_Torch>
    </prefabs>
    <parts>
      <Corpse>0.4</Corpse>
    </parts>
  </LayoutRoomDef>

  <!-- The armory: racks stripped long ago, the chest they could not open -->
  <LayoutRoomDef>
    <defName>TSC_Armory</defName>
    <floorTypes>
      <li>FlagstoneGranite</li>
    </floorTypes>
    <prefabs>
      <TSC_Shelf_Wood>
        <countPerTenEdgeCells>2</countPerTenEdgeCells>
        <minMaxRange>2~6</minMaxRange>
      </TSC_Shelf_Wood>
      <TSC_ArmoryChestPrefab>
        <countRange>1~1</countRange>
      </TSC_ArmoryChestPrefab>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>0~2</minMaxRange>
      </TSC_Torch>
    </prefabs>
    <parts>
      <Corpse>0.2</Corpse>
    </parts>
  </LayoutRoomDef>

  <!-- The chapel: marble underfoot and an altar that still answers -->
  <LayoutRoomDef>
    <defName>TSC_Chapel</defName>
    <minSingleRectWidth>6</minSingleRectWidth>
    <minSingleRectHeight>6</minSingleRectHeight>
    <floorTypes>
      <li>TileMarble</li>
    </floorTypes>
    <prefabs>
      <TSC_AltarNook>
        <countRange>1~1</countRange>
      </TSC_AltarNook>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>1~2</minMaxRange>
      </TSC_Torch>
    </prefabs>
    <parts>
      <Corpse>0.3</Corpse>
    </parts>
  </LayoutRoomDef>

  <!-- The lord's chamber: the good bed, the locked chest, the last tenant -->
  <LayoutRoomDef>
    <defName>TSC_LordsChamber</defName>
    <minSingleRectWidth>6</minSingleRectWidth>
    <minSingleRectHeight>6</minSingleRectHeight>
    <floorTypes>
      <li>WoodPlankFloor</li>
    </floorTypes>
    <prefabs>
      <TSC_Bunk>
        <countRange>1~1</countRange>
      </TSC_Bunk>
      <TSC_GuildChestPrefab>
        <countRange>1~1</countRange>
      </TSC_GuildChestPrefab>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>1~2</minMaxRange>
      </TSC_Torch>
    </prefabs>
    <parts>
      <Corpse>0.5</Corpse>
    </parts>
  </LayoutRoomDef>

  <!-- ============ Catacomb rooms (Chapter 2) ============ -->

  <!-- Crypt gallery: rows of stone sarcophagi. Something nests here. -->
  <LayoutRoomDef>
    <defName>TSC_Crypt</defName>
    <canMergeWithAdjacentRoom>true</canMergeWithAdjacentRoom>
    <floorTypes>
      <li>FlagstoneGranite</li>
    </floorTypes>
    <prefabs>
      <TSC_SarcophagusPair>
        <countPerHundredCells>2</countPerHundredCells>
        <minMaxRange>1~4</minMaxRange>
      </TSC_SarcophagusPair>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>0~2</minMaxRange>
      </TSC_Torch>
    </prefabs>
    <parts>
      <Corpse>0.4</Corpse>
      <!-- Halved from 0.75 in the insect cutback: the barrow keeps SOME
           sleeping tenants (Oswin promises them, and the moss cellar's
           guaranteed cluster backstops an unlucky roll), but the hive
           wall-to-wall is gone. Roaming vermin and occupants carry the
           rest of the danger now. -->
      <DormantInsectCluster>0.4</DormantInsectCluster>
    </parts>
  </LayoutRoomDef>

  <!-- The same crypt gallery, for places built almost ENTIRELY out of crypt
       galleries.

       TSC_Crypt's 0.75 nest chance is tuned for the moss barrow, where the
       room is one of three types on a small map and a low roll risks an
       empty dungeon. The Sunken Cellars and the procedural delves give this
       room a weight of 4 to 6 against a total of 7 to 9, so two rooms in
       three ARE crypts - and at 0.75 that meant a nest in very nearly every
       room, on top of the loose vermin the genstep scatters. Three floors of
       unbroken insects is not a dungeon, it is a chore.

       0.4 puts a nest in roughly every other crypt, which leaves quiet rooms
       to search, corners to be ambushed from, and somewhere to retreat to. -->
  <LayoutRoomDef>
    <defName>TSC_CryptQuiet</defName>
    <canMergeWithAdjacentRoom>true</canMergeWithAdjacentRoom>
    <floorTypes>
      <li>FlagstoneGranite</li>
    </floorTypes>
    <prefabs>
      <TSC_SarcophagusPair>
        <countPerHundredCells>2</countPerHundredCells>
        <minMaxRange>1~4</minMaxRange>
      </TSC_SarcophagusPair>
      <TSC_Torch>
        <countPerTenEdgeCells>1</countPerTenEdgeCells>
        <minMaxRange>0~2</minMaxRange>
      </TSC_Torch>
    </prefabs>
    <parts>
      <Corpse>0.4</Corpse>
      <!-- 0.4 -> 0.15 in the insect cutback: a nest is now the exception
           a delve crew remembers, not the wallpaper. -->
      <DormantInsectCluster>0.15</DormantInsectCluster>
    </parts>
  </LayoutRoomDef>

  <!-- Mosskeeper's cell (Act 1 sidequest). The moss itself lies loose on
       the crypt floor - spawned by GenStep_TSC_BarrowCrypt, no chest. -->
  <LayoutRoomDef>
    <defName>TSC_MossCellar</defName>
    <minSingleRectWidth>6</minSingleRectWidth>
    <minSingleRectHeight>6</minSingleRectHeight>
    <floorTypes>
      <li>FlagstoneGranite</li>
    </floorTypes>
    <parts>
      <DormantInsectCluster />
      <Corpse>0.3</Corpse>
    </parts>
  </LayoutRoomDef>

  <!-- The reliquary: guaranteed once, holds the Kingsblade. Guarded. -->
  <LayoutRoomDef>
    <defName>TSC_CryptReliquary</defName>
    <minSingleRectWidth>7</minSingleRectWidth>
    <minSingleRectHeight>7</minSingleRectHeight>
    <floorTypes>
      <li>TileMarble</li>
    </floorTypes>
    <prefabs>
      <TSC_Reliquary>
        <countRange>1~1</countRange>
      </TSC_Reliquary>
    </prefabs>
    <parts>
      <DormantInsectCluster />
      <Corpse>0.3</Corpse>
    </parts>
  </LayoutRoomDef>

</Defs>
