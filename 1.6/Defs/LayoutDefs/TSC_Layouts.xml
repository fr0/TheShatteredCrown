<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Chapter 1: the ruined watchtower. A small stone garrison, partly collapsed. -->
  <StructureLayoutDef>
    <defName>TSC_Watchtower</defName>
    <workerClass>LayoutWorker_AncientRuins</workerClass>
    <canHaveMultipleLayoutsInRoom>true</canHaveMultipleLayoutsInRoom>
    <shouldDamage>true</shouldDamage>
    <areaPrunePercent>0.05</areaPrunePercent>
    <minRoomWidth>7</minRoomWidth>
    <minRoomHeight>7</minRoomHeight>
    <wallDef>Wall</wallDef>
    <wallStuffDef>BlocksGranite</wallStuffDef>
    <doorStuffDef>WoodLog</doorStuffDef>
    <wallLampChancePerPosition>0</wallLampChancePerPosition>
    <ensureOneDoorUnlocked>true</ensureOneDoorUnlocked>
    <roomDefs>
      <!-- Objective -->
      <TSC_Vault>
        <countRange>1~1</countRange>
      </TSC_Vault>

      <!-- Flavor -->
      <TSC_GreatRoom>2</TSC_GreatRoom>
      <TSC_Barracks>2</TSC_Barracks>
      <TSC_Storeroom>1</TSC_Storeroom>
      <TSC_RubbleChamber>3</TSC_RubbleChamber>
    </roomDefs>
    <junkScaterrers>
      <RubblePile>
        <groupsPerHundredCells>1~3</groupsPerHundredCells>
        <itemsPerGroup>2~4</itemsPerGroup>
        <groupDistRange>3~5</groupDistRange>
      </RubblePile>
      <Filth_RubbleRock>
        <groupsPerHundredCells>1~3</groupsPerHundredCells>
        <itemsPerGroup>3~8</itemsPerGroup>
        <groupDistRange>3~5</groupDistRange>
      </Filth_RubbleRock>
    </junkScaterrers>
    <parts>
      <Breached>0.1</Breached>
      <Gore>0.05</Gore>
    </parts>
  </StructureLayoutDef>

  <!-- Cold Iron sidequest: the ruined waystation. Same bones as the
       watchtower but NO vault - the vault holds the intro's map-case
       chest, which belongs to the watchtower alone. The grave-iron here
       is scattered loose by GenStep_TSC_ScatterItems, not chested. -->
  <StructureLayoutDef>
    <defName>TSC_Waystation</defName>
    <workerClass>LayoutWorker_AncientRuins</workerClass>
    <canHaveMultipleLayoutsInRoom>true</canHaveMultipleLayoutsInRoom>
    <shouldDamage>true</shouldDamage>
    <areaPrunePercent>0.05</areaPrunePercent>
    <minRoomWidth>7</minRoomWidth>
    <minRoomHeight>7</minRoomHeight>
    <wallDef>Wall</wallDef>
    <wallStuffDef>BlocksGranite</wallStuffDef>
    <doorStuffDef>WoodLog</doorStuffDef>
    <wallLampChancePerPosition>0</wallLampChancePerPosition>
    <ensureOneDoorUnlocked>true</ensureOneDoorUnlocked>
    <roomDefs>
      <TSC_GreatRoom>1</TSC_GreatRoom>
      <TSC_Barracks>1</TSC_Barracks>
      <TSC_Storeroom>2</TSC_Storeroom>
      <TSC_RubbleChamber>3</TSC_RubbleChamber>
    </roomDefs>
    <junkScaterrers>
      <RubblePile>
        <groupsPerHundredCells>1~3</groupsPerHundredCells>
        <itemsPerGroup>2~4</itemsPerGroup>
        <groupDistRange>3~5</groupDistRange>
      </RubblePile>
      <Filth_RubbleRock>
        <groupsPerHundredCells>1~3</groupsPerHundredCells>
        <itemsPerGroup>3~8</itemsPerGroup>
        <groupDistRange>3~5</groupDistRange>
      </Filth_RubbleRock>
    </junkScaterrers>
    <parts>
      <Breached>0.15</Breached>
      <Gore>0.05</Gore>
    </parts>
  </StructureLayoutDef>

  <!-- Act 1 sidequest: a small barrow holding remembrance moss caches -->
  <StructureLayoutDef>
    <defName>TSC_MossBarrow</defName>
    <workerClass>LayoutWorker_AncientRuins</workerClass>
    <canHaveMultipleLayoutsInRoom>true</canHaveMultipleLayoutsInRoom>
    <minRoomWidth>7</minRoomWidth>
    <minRoomHeight>7</minRoomHeight>
    <wallDef>Wall</wallDef>
    <wallStuffDef>BlocksGranite</wallStuffDef>
    <doorStuffDef>WoodLog</doorStuffDef>
    <wallLampChancePerPosition>0</wallLampChancePerPosition>
    <ensureOneDoorUnlocked>true</ensureOneDoorUnlocked>
    <canDisconnectRooms>false</canDisconnectRooms>
    <roomDefs>
      <TSC_MossCellar>
        <countRange>1~1</countRange>
      </TSC_MossCellar>
      <TSC_Crypt>3</TSC_Crypt>
      <TSC_RubbleChamber>2</TSC_RubbleChamber>
    </roomDefs>
    <junkScaterrers>
      <Filth_RubbleRock>
        <groupsPerHundredCells>2~4</groupsPerHundredCells>
        <itemsPerGroup>3~8</itemsPerGroup>
        <groupDistRange>3~5</groupDistRange>
      </Filth_RubbleRock>
    </junkScaterrers>
    <parts>
      <Gore>0.1</Gore>
    </parts>
  </StructureLayoutDef>

  <!-- Chapter 2: the sunken cellars. Intact stone catacombs under a dead village. -->
  <!-- The ruined fortress: Adventure Mode's castle, procedurally roomed.
       Great hall, chapel (altar rite), armory (war-gear chest), the lord's
       chamber (guild chest - manuals ride in its loot), barracks and stores
       and collapse. Spawned by GenStep_TSC_Layout at castle footprint;
       threat points from the discovering site. -->
  <StructureLayoutDef>
    <defName>TSC_Castle</defName>
    <workerClass>LayoutWorker_AncientRuins</workerClass>
    <canHaveMultipleLayoutsInRoom>true</canHaveMultipleLayoutsInRoom>
    <shouldDamage>true</shouldDamage>
    <areaPrunePercent>0.05</areaPrunePercent>
    <minRoomWidth>7</minRoomWidth>
    <minRoomHeight>7</minRoomHeight>
    <wallDef>Wall</wallDef>
    <wallStuffDef>BlocksGranite</wallStuffDef>
    <doorStuffDef>WoodLog</doorStuffDef>
    <wallLampChancePerPosition>0</wallLampChancePerPosition>
    <ensureOneDoorUnlocked>true</ensureOneDoorUnlocked>
    <canDisconnectRooms>false</canDisconnectRooms>
    <roomDefs>
      <TSC_CastleHall>
        <countRange>1~1</countRange>
      </TSC_CastleHall>
      <TSC_Chapel>
        <countRange>1~1</countRange>
      </TSC_Chapel>
      <TSC_Armory>
        <countRange>1~1</countRange>
      </TSC_Armory>
      <TSC_LordsChamber>
        <countRange>1~1</countRange>
      </TSC_LordsChamber>
      <TSC_Barracks>2</TSC_Barracks>
      <TSC_Storeroom>2</TSC_Storeroom>
      <TSC_RubbleChamber>2</TSC_RubbleChamber>
    </roomDefs>
    <junkScaterrers>
      <RubblePile>
        <groupsPerHundredCells>1~3</groupsPerHundredCells>
      </RubblePile>
    </junkScaterrers>
  </StructureLayoutDef>

  <!-- The Iron Brand keep. Same bones as TSC_Castle, held rather than
       abandoned: light wall damage instead of a collapse, torches in the
       brackets because somebody lights them, flagstone underfoot, and one
       rubble chamber instead of two. TSC_Castle is left alone so the
       Adventure Mode contract castles keep their ruined look. -->
  <StructureLayoutDef>
    <defName>TSC_KeepCastle</defName>
    <workerClass>LayoutWorker_AncientRuins</workerClass>
    <canHaveMultipleLayoutsInRoom>true</canHaveMultipleLayoutsInRoom>
    <shouldDamage>true</shouldDamage>
    <wallDamageRange>0~25</wallDamageRange>
    <areaPrunePercent>0.02</areaPrunePercent>
    <minRoomWidth>7</minRoomWidth>
    <minRoomHeight>7</minRoomHeight>
    <wallDef>Wall</wallDef>
    <wallStuffDef>BlocksGranite</wallStuffDef>
    <doorStuffDef>WoodLog</doorStuffDef>
    <terrainDef>FlagstoneGranite</terrainDef>
    <!-- No wallLampDef: vanilla only ships wall-ATTACHMENT lights (the
         ancient emergency lamps), and a floor torch dropped into a wall slot
         either fails to spawn or eats the wall. The keep gets its lit-and-
         lived-in look from torches set around the courtyard instead. -->
    <wallLampChancePerPosition>0</wallLampChancePerPosition>
    <ensureOneDoorUnlocked>true</ensureOneDoorUnlocked>
    <canDisconnectRooms>false</canDisconnectRooms>
    <roomDefs>
      <TSC_CastleHall>
        <countRange>1~1</countRange>
      </TSC_CastleHall>
      <TSC_Chapel>
        <countRange>1~1</countRange>
      </TSC_Chapel>
      <TSC_Armory>
        <countRange>1~1</countRange>
      </TSC_Armory>
      <TSC_LordsChamber>
        <countRange>1~1</countRange>
      </TSC_LordsChamber>
      <TSC_Barracks>3</TSC_Barracks>
      <TSC_Storeroom>2</TSC_Storeroom>
      <TSC_RubbleChamber>1</TSC_RubbleChamber>
    </roomDefs>
    <junkScaterrers>
      <RubblePile>
        <groupsPerHundredCells>0~1</groupsPerHundredCells>
      </RubblePile>
    </junkScaterrers>
  </StructureLayoutDef>

  <StructureLayoutDef>
    <defName>TSC_Catacombs</defName>
    <workerClass>LayoutWorker_AncientRuins</workerClass>
    <canHaveMultipleLayoutsInRoom>true</canHaveMultipleLayoutsInRoom>
    <minRoomWidth>7</minRoomWidth>
    <minRoomHeight>7</minRoomHeight>
    <wallDef>Wall</wallDef>
    <wallStuffDef>BlocksGranite</wallStuffDef>
    <doorStuffDef>WoodLog</doorStuffDef>
    <wallLampChancePerPosition>0</wallLampChancePerPosition>
    <ensureOneDoorUnlocked>true</ensureOneDoorUnlocked>
    <canDisconnectRooms>false</canDisconnectRooms>
    <corridorShapes>Cross, T</corridorShapes>
    <roomDefs>
      <!-- Objective -->
      <TSC_CryptReliquary>
        <countRange>1~1</countRange>
      </TSC_CryptReliquary>

      <!-- Flavor and danger -->
      <TSC_CryptQuiet>4</TSC_CryptQuiet>
      <TSC_Storeroom>1</TSC_Storeroom>
      <TSC_RubbleChamber>2</TSC_RubbleChamber>
    </roomDefs>
    <junkScaterrers>
      <Filth_RubbleRock>
        <groupsPerHundredCells>2~4</groupsPerHundredCells>
        <itemsPerGroup>3~8</itemsPerGroup>
        <groupDistRange>3~5</groupDistRange>
      </Filth_RubbleRock>
    </junkScaterrers>
    <parts>
      <Gore>0.15</Gore>
    </parts>
  </StructureLayoutDef>

  <!-- The lower cellar floors: tighter, meaner rooms than the undercroft,
       wall to wall with the dead. Narrow minimums on purpose - the catacomb
       feel is corridors and cells, not halls. -->
  <StructureLayoutDef>
    <defName>TSC_Ossuary</defName>
    <workerClass>LayoutWorker_AncientRuins</workerClass>
    <canHaveMultipleLayoutsInRoom>true</canHaveMultipleLayoutsInRoom>
    <minRoomWidth>5</minRoomWidth>
    <minRoomHeight>5</minRoomHeight>
    <wallDef>Wall</wallDef>
    <wallStuffDef>BlocksMarble</wallStuffDef>
    <doorStuffDef>WoodLog</doorStuffDef>
    <wallLampChancePerPosition>0</wallLampChancePerPosition>
    <ensureOneDoorUnlocked>true</ensureOneDoorUnlocked>
    <canDisconnectRooms>false</canDisconnectRooms>
    <corridorShapes>Cross, T</corridorShapes>
    <roomDefs>
      <TSC_CryptQuiet>6</TSC_CryptQuiet>
      <TSC_RubbleChamber>2</TSC_RubbleChamber>
      <TSC_Storeroom>1</TSC_Storeroom>
    </roomDefs>
    <junkScaterrers>
      <Filth_RubbleRock>
        <groupsPerHundredCells>3~5</groupsPerHundredCells>
        <itemsPerGroup>3~8</itemsPerGroup>
        <groupDistRange>3~5</groupDistRange>
      </Filth_RubbleRock>
    </junkScaterrers>
    <parts>
      <Gore>0.25</Gore>
    </parts>
  </StructureLayoutDef>

  <!-- Act 4: the Silent Monastery. Intact where the castle is ruined - the
       plague emptied it; nobody ever sacked it. Chapel, refectory,
       dormitories, stores. Deliberately undamaged and unpruned: the horror
       is that everything is exactly where the brothers left it. Act 4
       proper hangs its scenes on these rooms; the layout spawns no
       occupants of its own. -->
  <StructureLayoutDef>
    <defName>TSC_Monastery</defName>
    <workerClass>LayoutWorker_AncientRuins</workerClass>
    <canHaveMultipleLayoutsInRoom>true</canHaveMultipleLayoutsInRoom>
    <shouldDamage>false</shouldDamage>
    <areaPrunePercent>0</areaPrunePercent>
    <minRoomWidth>7</minRoomWidth>
    <minRoomHeight>7</minRoomHeight>
    <wallDef>Wall</wallDef>
    <wallStuffDef>BlocksGranite</wallStuffDef>
    <doorStuffDef>WoodLog</doorStuffDef>
    <wallLampChancePerPosition>0</wallLampChancePerPosition>
    <ensureOneDoorUnlocked>true</ensureOneDoorUnlocked>
    <canDisconnectRooms>false</canDisconnectRooms>
    <roomDefs>
      <TSC_MonChapel>
        <countRange>1~1</countRange>
      </TSC_MonChapel>
      <TSC_Refectory>
        <countRange>1~1</countRange>
      </TSC_Refectory>
      <TSC_Dormitory>
        <countRange>1~2</countRange>
      </TSC_Dormitory>
      <TSC_Scriptorium>
        <countRange>1~1</countRange>
      </TSC_Scriptorium>
      <TSC_Pantry>
        <countRange>1~2</countRange>
      </TSC_Pantry>
    </roomDefs>
  </StructureLayoutDef>

</Defs>
