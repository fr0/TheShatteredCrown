<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ==================================================================
       Adventure Mode contract sites, round two.

       The board had four templates and three of them ended in "kill what is
       there": a camp, a ruin with a strongbox, a den with a beast. These add
       jobs that are NOT primarily a fight - a nest that has to be burned out
       of a building, and a rider the guild wants back alive - and they lean
       on the proficiency spots rather than on the party's weapons.

       Same rules as round one: generic shells, quest text carries the
       flavour, nothing persists past its contract.
       ================================================================== -->

  <!-- ================================================ the nest -->

  <SitePartDef>
    <defName>TSC_ContractNest</defName>
    <label>infested works</label>
    <description>An old stone building on a guild contract. Something has lived in it long enough to change the shape of the rooms.</description>
    <siteTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</siteTexture>
    <expandingIconTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</expandingIconTexture>
    <approachOrderString>Clear {0}</approachOrderString>
    <approachingReportString>Travelling to {0}.</approachingReportString>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
    <wantsThreatPoints>true</wantsThreatPoints>
    <minThreatPoints>120</minThreatPoints>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
    <tags>
      <li>TSC_ContractNest</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>TSC_ContractNest_Structure</defName>
    <linkWithSite>TSC_ContractNest</linkWithSite>
    <order>470</order>
    <genStep Class="GenStep_AncientRuins">
      <layoutDef>TSC_Waystation</layoutDef>
    </genStep>
  </GenStepDef>

  <!-- The tenants. Same "post guards around a point" spawner the ruin uses,
       now pointed at insects: the waystation layout consumes no threat
       points of its own, so without this the map generates empty. -->
  <GenStepDef>
    <defName>TSC_ContractNest_Swarm</defName>
    <linkWithSite>TSC_ContractNest</linkWithSite>
    <order>483</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_BanditGuards">
      <faction>insects</faction>
      <kinds>
        <li>Megascarab</li>
        <li>Spelopede</li>
        <li>Megascarab</li>
        <li>Megaspider</li>
      </kinds>
      <count>3~5</count>
      <scaledClamp>2~9</scaledClamp>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_ContractNest_Spots</defName>
    <linkWithSite>TSC_ContractNest</linkWithSite>
    <order>485</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_PlaceCheckSpots">
      <spots>
        <li>
          <def>TSC_ChewedTimbers</def>
          <count>1~1</count>
        </li>
        <li>
          <def>TSC_SpoorTrail</def>
          <count>1~1</count>
        </li>
        <li>
          <def>TSC_GrislyRemains</def>
          <count>0~1</count>
        </li>
        <li>
          <def>TSC_CollapsedPassage</def>
          <count>0~1</count>
        </li>
        <li>
          <def>TSC_ArmoryChest</def>
          <count>0~1</count>
        </li>
      </spots>
    </genStep>
  </GenStepDef>

  <!-- ================================================ the missing rider -->

  <SitePartDef>
    <defName>TSC_ContractCaptive</defName>
    <label>holdfast</label>
    <description>A bandit holdfast on a guild contract. They are holding somebody the guild wants back alive.</description>
    <siteTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</siteTexture>
    <expandingIconTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</expandingIconTexture>
    <approachOrderString>Raid {0}</approachOrderString>
    <approachingReportString>Travelling to {0}.</approachingReportString>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
    <wantsThreatPoints>true</wantsThreatPoints>
    <minThreatPoints>140</minThreatPoints>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
    <tags>
      <li>TSC_ContractCaptive</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>TSC_ContractCaptive_Structure</defName>
    <linkWithSite>TSC_ContractCaptive</linkWithSite>
    <order>470</order>
    <genStep Class="GenStep_AncientRuins">
      <layoutDef>TSC_Waystation</layoutDef>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_ContractCaptive_Guards</defName>
    <linkWithSite>TSC_ContractCaptive</linkWithSite>
    <order>483</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_BanditGuards">
      <count>5~8</count>
      <scaledClamp>4~11</scaledClamp>
    </genStep>
  </GenStepDef>

  <!-- The prisoner: spawned downed and factionless, joins the moment one of
       yours reaches them. Reuses the discovery-site rescue machinery whole. -->
  <GenStepDef>
    <defName>TSC_ContractCaptive_Prisoner</defName>
    <linkWithSite>TSC_ContractCaptive</linkWithSite>
    <order>484</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_Captive" />
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_ContractCaptive_Spots</defName>
    <linkWithSite>TSC_ContractCaptive</linkWithSite>
    <order>485</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_PlaceCheckSpots">
      <!-- No TSC_PrisonersMarks here: its fiction is old scratches in an
           abandoned ruin, and this site has a LIVE prisoner ten feet away.
           The rescue tells that story itself. -->
      <spots>
        <li>
          <def>TSC_RansomLedger</def>
          <count>1~1</count>
        </li>
        <li>
          <def>TSC_BanditLedger</def>
          <count>0~1</count>
        </li>
        <li>
          <def>TSC_WatchPost</def>
          <count>0~1</count>
        </li>
        <li>
          <def>TSC_CampfireCircle</def>
          <count>0~1</count>
        </li>
      </spots>
    </genStep>
  </GenStepDef>

</Defs>
