<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ==================================================================
       Adventure Mode contract sites, round three: six more shells for the
       board.

       Everything here is built from gensteps that already existed - the
       guard poster (now roster-driven), the structure placer, the check-spot
       placer, the ancient-ruins layout worker. What varies is the LAYOUT the
       job happens in, WHO holds it, and what the guild wants out of it,
       which is what the player actually experiences as a different contract.

       Core only: no shamblers or other DLC-gated kinds, so the board works
       for anyone.
       ================================================================== -->

  <!-- ============================================ 1. the redoubt (hard) -->
  <SitePartDef>
    <defName>TSC_ContractRedoubt</defName>
    <label>bandit redoubt</label>
    <description>Not a camp. Somebody took a fortified ruin, mended the walls, and has been charging the road ever since.</description>
    <siteTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</siteTexture>
    <expandingIconTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</expandingIconTexture>
    <approachOrderString>Storm {0}</approachOrderString>
    <approachingReportString>Traveling to {0}.</approachingReportString>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
    <wantsThreatPoints>true</wantsThreatPoints>
    <minThreatPoints>200</minThreatPoints>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
    <tags>
      <li>TSC_ContractRedoubt</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>TSC_ContractRedoubt_Structure</defName>
    <linkWithSite>TSC_ContractRedoubt</linkWithSite>
    <order>470</order>
    <genStep Class="GenStep_AncientRuins">
      <layoutDef>TSC_Castle</layoutDef>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_ContractRedoubt_Garrison</defName>
    <linkWithSite>TSC_ContractRedoubt</linkWithSite>
    <order>483</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_BanditGuards">
      <kinds>
        <li>TSC_Bandit_Brigand</li>
        <li>TSC_Bandit_Archer</li>
        <li>TSC_Bandit_Brigand</li>
        <li>TSC_BanditHexer</li>
      </kinds>
      <count>5~7</count>
      <scaledClamp>4~12</scaledClamp>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_ContractRedoubt_Spots</defName>
    <linkWithSite>TSC_ContractRedoubt</linkWithSite>
    <order>485</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_PlaceCheckSpots">
      <spots>
        <li><def>TSC_BanditLedger</def><count>1~1</count></li>
        <li><def>TSC_WatchPost</def><count>1~1</count></li>
        <li><def>TSC_ArmoryChest</def><count>1~1</count></li>
        <li><def>TSC_ParleyStone</def><count>0~1</count></li>
        <li><def>TSC_PrisonersMarks</def><count>0~1</count></li>
      </spots>
    </genStep>
  </GenStepDef>

  <!-- ============================================ 2. the warren (mixed) -->
  <SitePartDef>
    <defName>TSC_ContractWarren</defName>
    <label>warren</label>
    <description>A ruin with two sets of tenants who have divided up the corridors between them. Neither will include you in that.</description>
    <siteTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</siteTexture>
    <expandingIconTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</expandingIconTexture>
    <approachOrderString>Clear {0}</approachOrderString>
    <approachingReportString>Traveling to {0}.</approachingReportString>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
    <wantsThreatPoints>true</wantsThreatPoints>
    <minThreatPoints>150</minThreatPoints>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
    <tags>
      <li>TSC_ContractWarren</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>TSC_ContractWarren_Structure</defName>
    <linkWithSite>TSC_ContractWarren</linkWithSite>
    <order>470</order>
    <genStep Class="GenStep_AncientRuins">
      <layoutDef>TSC_Waystation</layoutDef>
    </genStep>
  </GenStepDef>

  <!-- Two posts, two factions, one building: the squatters hold one end and
       whatever else got there first holds the other. They fight each other
       as readily as they fight you,
       which is the point of the contract.

       Both sides run larger than a comparable one-faction garrison (3~6 a
       side, half again the original 2~4), because they spend themselves on
       each other once the player stirs the seam. The original size resolved
       the stand-off before the party mattered; the doubled size (4~8) proved
       over-tuned once the corner partition stopped the sides from bleeding
       each other at map generation. A side has to be big enough to still be
       a fight after it has had a fight - and no bigger. -->
  <GenStepDef>
    <defName>TSC_ContractWarren_Squatters</defName>
    <linkWithSite>TSC_ContractWarren</linkWithSite>
    <order>483</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_BanditGuards">
      <count>3~6</count>
      <scaledClamp>3~10</scaledClamp>
      <holdEnd>SW</holdEnd>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_ContractWarren_Vermin</defName>
    <linkWithSite>TSC_ContractWarren</linkWithSite>
    <order>484</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_BanditGuards">
      <!-- Whoever else got there first. Rolled per map, because a warren
           whose other end is insects every single time has one surprise in
           it and never again.

           Every crew here is hostile to the squatters as well as to the
           party, which is the contract's whole premise: insects are at war
           with everything, and a manhunting animal does not check factions
           before it charges. A rival human crew would need a faction the
           squatters' own faction is hostile to, which is not something a
           generated world guarantees, so that stays out for now.

           Kinds are named as strings and any that a load order lacks simply
           drop out; a crew left with nothing is skipped in the roll. -->
      <crews>
        <li>
          <faction>insects</faction>
          <kinds>
            <li>Megascarab</li>
            <li>Spelopede</li>
          </kinds>
          <pickOneKind>false</pickOneKind>
          <weight>1.4</weight>
        </li>
        <li>
          <!-- A pack: one kind for the whole crew, and already hunting. -->
          <faction>wild</faction>
          <manhunter>true</manhunter>
          <kinds>
            <li>Wolf_Timber</li>
            <li>Wolf_Arctic</li>
            <li>Warg</li>
            <li>Lynx</li>
            <li>Cougar</li>
          </kinds>
          <weight>1.2</weight>
        </li>
        <li>
          <!-- Heavier animals: fewer things that bite, each of them worse. -->
          <faction>wild</faction>
          <manhunter>true</manhunter>
          <kinds>
            <li>Bear_Grizzly</li>
            <li>Bear_Polar</li>
            <li>Boar</li>
            <li>WildBoar</li>
          </kinds>
          <weight>0.7</weight>
        </li>
        <li>
          <!-- Scavengers that took the cellar: many, weak, everywhere. -->
          <faction>wild</faction>
          <manhunter>true</manhunter>
          <kinds>
            <li>Rat</li>
            <li>Raccoon</li>
            <li>Boomrat</li>
          </kinds>
          <weight>0.6</weight>
        </li>
      </crews>
      <count>3~6</count>
      <scaledClamp>3~10</scaledClamp>
      <holdEnd>NE</holdEnd>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_ContractWarren_Spots</defName>
    <linkWithSite>TSC_ContractWarren</linkWithSite>
    <order>485</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_PlaceCheckSpots">
      <spots>
        <li><def>TSC_ChewedTimbers</def><count>1~1</count></li>
        <li><def>TSC_BanditLedger</def><count>1~1</count></li>
        <li><def>TSC_SpoorTrail</def><count>0~1</count></li>
        <li><def>TSC_CollapsedPassage</def><count>0~1</count></li>
        <li><def>TSC_ContractChest</def><count>0~1</count></li>
      </spots>
    </genStep>
  </GenStepDef>

