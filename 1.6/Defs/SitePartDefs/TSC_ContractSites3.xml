  <!-- ============================================ 6. the wreck (fetch, open) -->
  <SitePartDef>
    <defName>TSC_ContractWreck</defName>
    <label>plundered wreck</label>
    <description>A guild caravan that never arrived, spread across the road outside an old watch-post. Whoever wrecked it has dragged the good boxes inside.</description>
    <siteTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</siteTexture>
    <expandingIconTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</expandingIconTexture>
