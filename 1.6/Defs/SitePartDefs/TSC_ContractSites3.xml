      <li>TSC_ContractWreck</li>
    </tags>
  </SitePartDef>

  <!-- A ruined roadside post, which is the SMALLEST layout the mod has and
       carries a vault room. GenStep_TSC_PlaceInStructure hunts for the
       deepest enclosed, roofed, edge-reachable cell, so it needs a structure
       to hunt in: without one the crate falls back to open ground, which is
       how the guild strongbox ended up sitting in open desert before.
       The wreck is still outside; the coffer is what got dragged in. -->
  <GenStepDef>
    <defName>TSC_ContractWreck_Structure</defName>
    <linkWithSite>TSC_ContractWreck</linkWithSite>
    <order>470</order>
    <genStep Class="GenStep_AncientRuins">
      <layoutDef>TSC_Watchtower</layoutDef>
    </genStep>
