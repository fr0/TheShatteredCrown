<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Harrowfield village buildings. Hand-authored: granite walls, wood doors,
       plank floors. Local coords: (x,0,z) from the prefab's own origin.
       RECTS ARE INCLUSIVE CORNERS: (minX,minZ,maxX,maxZ) - the vanilla
       CellRect parse. NOT width/height (that mistake produced L-shaped
       wall blobs and missing walls in generated houses). -->

  <!-- A villager's cottage: bed, table, chair, torch. Door on the south wall. -->
  <PrefabDef>
    <defName>TSC_Cottage</defName>
    <size>(8,7)</size>
    <things>
      <Wall>
        <rects>
          <li>(0,0,2,0)</li>
          <li>(4,0,7,0)</li>
          <li>(0,6,7,6)</li>
          <li>(0,1,0,5)</li>
          <li>(7,1,7,5)</li>
        </rects>
        <stuff>BlocksGranite</stuff>
      </Wall>
      <Door>
        <position>(3,0,0)</position>
        <stuff>WoodLog</stuff>
      </Door>
      <Bed>
        <position>(1,0,3)</position>
        <stuff>WoodLog</stuff>
      </Bed>
      <Table2x2c>
        <position>(4,0,3)</position>
        <stuff>WoodLog</stuff>
      </Table2x2c>
      <DiningChair>
        <position>(4,0,2)</position>
        <stuff>WoodLog</stuff>
      </DiningChair>
      <TorchLamp>
        <position>(6,0,1)</position>
      </TorchLamp>
    </things>
    <terrain>
      <WoodPlankFloor>
        <rects>
          <li>(1,1,6,5)</li>
          <li>(3,0,3,0)</li>
        </rects>
      </WoodPlankFloor>
    </terrain>
  </PrefabDef>

  <!-- A smaller cottage (Bram's old house stands empty) -->
  <PrefabDef>
    <defName>TSC_CottageSmall</defName>
    <size>(7,6)</size>
    <things>
      <Wall>
        <rects>
          <li>(0,0,2,0)</li>
          <li>(4,0,6,0)</li>
          <li>(0,5,6,5)</li>
          <li>(0,1,0,4)</li>
          <li>(6,1,6,4)</li>
        </rects>
        <stuff>BlocksGranite</stuff>
      </Wall>
      <Door>
        <position>(3,0,0)</position>
        <stuff>WoodLog</stuff>
      </Door>
      <Bed>
        <position>(1,0,3)</position>
        <stuff>WoodLog</stuff>
      </Bed>
      <DiningChair>
        <position>(5,0,3)</position>
        <stuff>WoodLog</stuff>
      </DiningChair>
      <TorchLamp>
        <position>(5,0,1)</position>
      </TorchLamp>
    </things>
    <terrain>
      <WoodPlankFloor>
        <rects>
          <li>(1,1,5,4)</li>
          <li>(3,0,3,0)</li>
        </rects>
      </WoodPlankFloor>
    </terrain>
  </PrefabDef>

  <!-- The smithy: forge, workbench shelf, stone floor, and Haldor's bed in
       the corner (he lives where he works) -->
  <PrefabDef>
    <defName>TSC_Smithy</defName>
    <size>(8,6)</size>
    <things>
      <Wall>
        <rects>
          <li>(0,0,3,0)</li>
          <li>(5,0,7,0)</li>
          <li>(0,5,7,5)</li>
          <li>(0,1,0,4)</li>
          <li>(7,1,7,4)</li>
        </rects>
        <stuff>BlocksGranite</stuff>
      </Wall>
      <Door>
        <position>(4,0,0)</position>
        <stuff>WoodLog</stuff>
      </Door>
      <FueledSmithy>
        <position>(2,0,3)</position>
      </FueledSmithy>
      <Shelf>
        <position>(2,0,1)</position>
        <stuff>WoodLog</stuff>
      </Shelf>
      <Bed>
        <position>(6,0,1)</position>
        <stuff>WoodLog</stuff>
      </Bed>
      <TorchLamp>
        <position>(6,0,3)</position>
      </TorchLamp>
    </things>
    <terrain>
      <FlagstoneGranite>
        <rects>
          <li>(1,1,6,4)</li>
          <li>(4,0,4,0)</li>
        </rects>
      </FlagstoneGranite>
    </terrain>
  </PrefabDef>

  <!-- The Wayfarers' campsite: firepit, bedrolls, gear crates. Open air. -->
  <PrefabDef>
    <defName>TSC_CampSite</defName>
    <size>(11,9)</size>
    <things>
      <Campfire>
        <position>(5,0,4)</position>
      </Campfire>
      <Bedroll>
        <positions>
          <li>(2,0,6)</li>
          <li>(8,0,6)</li>
          <li>(2,0,2)</li>
        </positions>
        <stuff>Cloth</stuff>
      </Bedroll>
      <TSC_CampCrate_Provisions>
        <position>(9,0,2)</position>
      </TSC_CampCrate_Provisions>
      <TSC_CampCrate_Sundries>
        <position>(10,0,2)</position>
      </TSC_CampCrate_Sundries>
      <TorchLamp>
        <positions>
          <li>(1,0,1)</li>
          <li>(9,0,7)</li>
        </positions>
      </TorchLamp>
      <Stool>
        <positions>
          <li>(4,0,3)</li>
          <li>(6,0,3)</li>
          <li>(5,0,6)</li>
        </positions>
        <chance>0.8</chance>
        <stuff>WoodLog</stuff>
      </Stool>
    </things>
    <terrain>
      <PackedDirt>
        <rects>
          <li>(0,0,10,8)</li>
        </rects>
      </PackedDirt>
    </terrain>
  </PrefabDef>

  <!-- The Crossed Swords inn. CURRENTLY UNUSED (Harrowfield has no inn, user decision); kept for future settlements. Common room with a long table
       and hearth, guest beds along the north wall, barrels behind the counter. -->
  <PrefabDef>
    <defName>TSC_Inn</defName>
    <size>(14,10)</size>
    <things>
      <Wall>
        <rects>
          <li>(0,0,5,0)</li>
          <li>(7,0,13,0)</li>
          <li>(0,9,13,9)</li>
          <li>(0,1,0,8)</li>
          <li>(13,1,13,8)</li>
        </rects>
        <stuff>BlocksGranite</stuff>
      </Wall>
      <Door>
        <position>(6,0,0)</position>
        <stuff>WoodLog</stuff>
      </Door>
      <Table2x4c>
        <position>(3,0,3)</position>
        <stuff>WoodLog</stuff>
      </Table2x4c>
      <DiningChair>
        <positions>
          <li>(2,0,3)</li>
          <li>(2,0,4)</li>
          <li>(2,0,5)</li>
        </positions>
        <chance>0.8</chance>
        <relativeRotation>Clockwise</relativeRotation>
        <stuff>WoodLog</stuff>
      </DiningChair>
      <DiningChair>
        <positions>
          <li>(5,0,3)</li>
          <li>(5,0,4)</li>
          <li>(5,0,5)</li>
        </positions>
        <chance>0.8</chance>
        <relativeRotation>Counterclockwise</relativeRotation>
        <stuff>WoodLog</stuff>
      </DiningChair>
      <Brazier MayRequire="Ludeon.RimWorld.Royalty">
        <position>(8,0,4)</position>
        <stuff>BlocksGranite</stuff>
      </Brazier>
      <Bed>
        <positions>
          <li>(9,0,7)</li>
          <li>(11,0,7)</li>
        </positions>
        <stuff>WoodLog</stuff>
      </Bed>
      <FermentingBarrel>
        <positions>
          <li>(11,0,1)</li>
          <li>(12,0,1)</li>
        </positions>
      </FermentingBarrel>
      <Shelf>
        <position>(9,0,1)</position>
        <stuff>WoodLog</stuff>
      </Shelf>
      <TorchLamp>
        <positions>
          <li>(1,0,8)</li>
          <li>(1,0,1)</li>
          <li>(12,0,8)</li>
        </positions>
      </TorchLamp>
    </things>
    <terrain>
      <WoodPlankFloor>
        <rects>
          <li>(1,1,12,8)</li>
          <li>(6,0,6,0)</li>
        </rects>
      </WoodPlankFloor>
    </terrain>
  </PrefabDef>


  <!-- The guild house: the Wayfarers' post in every friendly town
       (stamped near the settlement centre by MapComponent_TSC_GuildFactor;
       the factor works at the desk inside). Door on the south wall; the
       banner outside is placed by code, beside the door. -->
  <PrefabDef>
    <defName>TSC_GuildHouse</defName>
    <size>(9,7)</size>
    <things>
      <Wall>
        <rects>
          <li>(0,0,3,0)</li>
          <li>(5,0,8,0)</li>
          <li>(0,6,8,6)</li>
          <li>(0,1,0,5)</li>
          <li>(8,1,8,5)</li>
        </rects>
        <stuff>BlocksGranite</stuff>
      </Wall>
      <Door>
        <position>(4,0,0)</position>
        <stuff>WoodLog</stuff>
      </Door>
      <!-- The factor's desk; he stands just east of it, at the prefab centre. -->
      <Table2x2c>
        <position>(2,0,3)</position>
        <stuff>WoodLog</stuff>
      </Table2x2c>
      <DiningChair>
        <position>(2,0,2)</position>
        <stuff>WoodLog</stuff>
      </DiningChair>
      <!-- Visitors' bench side -->
      <DiningChair>
        <position>(5,0,2)</position>
        <stuff>WoodLog</stuff>
      </DiningChair>
      <EndTable>
        <position>(1,0,5)</position>
        <stuff>WoodLog</stuff>
      </EndTable>
      <EndTable>
        <position>(7,0,5)</position>
        <stuff>WoodLog</stuff>
      </EndTable>
      <TorchLamp>
        <position>(1,0,1)</position>
      </TorchLamp>
      <TorchLamp>
        <position>(7,0,1)</position>
      </TorchLamp>
    </things>
    <terrain>
      <WoodPlankFloor>
        <rects>
          <li>(1,1,7,5)</li>
          <li>(4,0,4,0)</li>
        </rects>
      </WoodPlankFloor>
    </terrain>
  </PrefabDef>

  <!-- The sign out front: how you find the guild in a strange town. -->
  <ThingDef ParentName="BuildingBase">
    <defName>TSC_GuildBanner</defName>
    <label>guild banner</label>
    <description>The Wayfarers' Guild sign: a gold coin on a dark board. Wherever it hangs, contracts are taken, help is hired, and the ledger is open.</description>
    <graphicData>
      <texPath>Things/Building/TSC_GuildBanner</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.1,1.4)</drawSize>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>14</pathCost>
    <rotatable>false</rotatable>
    <fillPercent>0.2</fillPercent>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.8</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <size>(1,1)</size>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>


