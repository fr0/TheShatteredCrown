      <Door>
        <position>(4,0,0)</position>
        <stuff>WoodLog</stuff>
      </Door>
      <!-- The forge line along the back wall -->
      <FueledSmithy>
        <position>(2,0,4)</position>
      </FueledSmithy>
      <Table2x2c>
        <position>(6,0,4)</position>
        <stuff>WoodLog</stuff>
      </Table2x2c>
      <Shelf>
        <position>(1,0,2)</position>
        <stuff>WoodLog</stuff>
      </Shelf>
      <EndTable>
        <position>(7,0,2)</position>
        <stuff>WoodLog</stuff>
      </EndTable>
      <TorchLamp>
        <position>(1,0,5)</position>
      </TorchLamp>
      <TorchLamp>
        <position>(7,0,5)</position>
      </TorchLamp>
    </things>
    <terrain>
      <FlagstoneGranite>
        <rects>
          <li>(1,1,7,5)</li>
          <li>(4,0,4,0)</li>
        </rects>
      </FlagstoneGranite>
    </terrain>
  </PrefabDef>


