<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ScenPartDef>
    <defName>TSC_IntroSetup</defName>
    <label>adventurers' guild intro</label>
    <category>Misc</category>
    <scenPartClass>TheShatteredCrown.ScenPart_TSC_IntroSetup</scenPartClass>
    <maxUses>1</maxUses>
  </ScenPartDef>

  <!-- The intended way to play the mod: a lone rider sent to find the guild's
       missing party. Companions are met along the way and recruited through
       conversation. -->
  <ScenarioDef ParentName="ScenarioBase">
    <defName>TSC_LoneAdventurer</defName>
    <label>The Shattered Crown</label>
    <description>The Wayfarers' Guild has hunted the shattered crown of Aldruin, the last king, for generations. At last their search got a hit: a clue that sent a party of adventurers into a mountain pass, chasing a shard of the crown or the trail of one.\n\nThat party has been gone too long. No communiqué in weeks.\n\nThis is where you come in: ride out, locate their camp, and find the party, whether they're alive or dead. You start alone, with a horse, crude gear, and basic supplies.\n\nNote: starting with a single character makes the early game challenging.</description>
    <scenario>
      <summary>One rider, one horse, and a missing party somewhere in the pass. RimWorld as an RPG.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>TSC_PlayerGuild</factionDef>
      </playerFaction>
      <parts>

        <!-- Give the intro quest at game start -->
        <li Class="TheShatteredCrown.ScenPart_TSC_IntroSetup">
          <def>TSC_IntroSetup</def>
          <visible>false</visible>
          <introQuest>TSC_Quest1_WayfarersCall</introQuest>
        </li>

        <!-- Config pages -->
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>1</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
        </li>

        <!-- Walk on, no drop pods: you arrived by road -->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <visible>false</visible>
          <method>Standing</method>
        </li>

        <!-- Crude gear and basic supplies -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>150</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Pemmican</thingDef>
          <count>100</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>8</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Knife</thingDef>
          <stuff>Steel</stuff>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Bow_Short</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Bedroll</thingDef>
          <stuff>Cloth</stuff>
        </li>

        <!-- The horse -->
        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <animalKind>Horse</animalKind>
          <count>1</count>
          <bondToRandomPlayerPawnChance>1.0</bondToRandomPlayerPawnChance>
        </li>

        <!-- Enough wood for a first shelter -->
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>250</count>
        </li>

        <!-- Game start dialog -->
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The guild-master's letter is short, the way bad news always is.\n\n"Serra Voss and her company went into the pass eight weeks ago, following the strongest lead on the crown in a generation. We have heard nothing since. Find the camp. Find them, alive or dead. The guild pays either way, but bring me the truth."\n\nOne rider, one horse, and a trail eight weeks cold. The last confirmed sighting: an old border ruin, marked on your map.</text>
          <closeSound>GameStartSting</closeSound>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>


  <!-- The player faction: the guild itself, fixed name (no "New Arrivals").
       A clone of vanilla PlayerColony with identity swapped; research tags
       deliberately untouched (a rename, not a rebalance). techLevel is
       Medieval: it is what the fiction says, scenario pickers that bucket
       by tech level (Progression: Scenarios reads the player faction def)
       file us under Medieval, and the vanilla research-cost penalty for
       above-era projects points the same direction as the mod's own
       medieval catalogs. -->
  <FactionDef ParentName="PlayerFactionBase">
    <defName>TSC_PlayerGuild</defName>
    <label>wayfarers' guild</label>
    <description>A far-riding company of the Wayfarers' Guild: adventurers, couriers, and seekers after the shattered crown of Aldruin.</description>
    <fixedName>The Wayfarers' Guild</fixedName>
    <isPlayer>true</isPlayer>
    <basicMemberKind>Colonist</basicMemberKind>
    <pawnSingular>adventurer</pawnSingular>
    <pawnsPlural>adventurers</pawnsPlural>
    <techLevel>Medieval</techLevel>
    <factionNameMaker>NamerFactionOutlander</factionNameMaker>
    <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
    <allowedCultures><li>Astropolitan</li></allowedCultures>
    <backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
      </li>
    </backstoryFilters>
    <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
    <startingResearchTags>
      <li>ClassicStart</li>
    </startingResearchTags>
    <startingTechprintsResearchTags>
      <li>ClassicStart</li>
      <li>ClassicStartTechprints</li>
    </startingTechprintsResearchTags>
    <!-- What starting and generated members of the company are dressed
         in. Synthread came along with the vanilla faction template this
         was cloned from, and put every adventurer in a fabric nobody in
         this century can weave. Cloth and leather only: the same list a
         medieval world's own tailors work from. -->
    <apparelStuffFilter>
      <thingDefs>
        <li>Cloth</li>
        <li>Leather_Plain</li>
        <li>Leather_Bear</li>
        <li>Leather_Wolf</li>
        <li>Leather_Bluefur</li>
        <li>Leather_Light</li>
        <li>Leather_Heavy</li>
        <li>WoolSheep</li>
        <li>WoolAlpaca</li>
        <li>WoolMuffalo</li>
      </thingDefs>
    </apparelStuffFilter>
  </FactionDef>

</Defs>
