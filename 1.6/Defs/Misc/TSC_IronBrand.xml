<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ================================================================
       Act 3: the Iron Brand. A bandit company grown fat behind stolen
       walls, with the third crown shard buried in their hoard. Opened by
       the second shard rush (TSC_ShardTracker fires shard_rush2.agd when
       both shards first ride together); the quest is TSC_Act3_IronBrand
       in QuestScripts/TSC_Act3_Quests.xml.
       ================================================================ -->

  <!-- The third shard. Same indestructibility contract as its kin: the
       campaign's spine runs through five of these. Its unique power is
       still sleeping - the extension marks it as a crown shard (drop
       guard, Kingsblade count) with no ability named yet. -->
  <ThingDef ParentName="ResourceBase">
    <defName>TSC_CrownShard_Hoard</defName>
    <label>crown shard of the hoard</label>
    <description>A broken fifth of a king's crown: a jawline of band and one snapped point, dulled by tallow smoke and other men's fingers. It spent a bandit generation at the bottom of a treasure pile, unrecognized. It is heavier than gold should be. One of five.\n\nIts gift has not yet spoken.</description>
    <graphicData>
      <texPath>Things/Item/TSC_CrownShard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <stackLimit>1</stackLimit>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <tradeability>None</tradeability>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <destroyOnDrop>false</destroyOnDrop>
    <statBases>
      <Mass>1.5</Mass>
      <MarketValue>2500</MarketValue>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <modExtensions>
      <li Class="TheShatteredCrown.TSC_ShardAbilityExtension">
        <ability>TSC_Ability_KingsMercy</ability>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- The King's Mercy: the third shard's power. Exactly a healer mech
       serum on one touched pawn (same vanilla call: the worst thing wrong
       with them is made right), once every fifteen days. The cooldown
       belongs to the shard, not the pawn - hand it around and the clock
       travels with it. No energy cost: it is not the pawn's magic. -->
  <AbilityDef ParentName="TSC_AbilityBase">
    <defName>TSC_Ability_KingsMercy</defName>
    <label>the king's mercy</label>
    <description>Lay the shard against a living body and the worst thing wrong with it is made right: a lost limb regrown, a disease lifted, an old scar mended. Whatever the dead king could not do for his kingdom, his crown can still do for one person at a time. The shard allows this once in fifteen days; carrying it is the only price.</description>
    <!-- The Healing Touch icon, tinted crown-gold: same hand, different
         power - and no longer identical to the cleric's button. -->
    <iconPath>UI/TSC_Abilities/TSC_KingsMercy</iconPath>
    <cooldownTicksRange>900000</cooldownTicksRange>
    <stunTargetWhileCasting>false</stunTargetWhileCasting>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <warmupTime>2</warmupTime>
      <range>3.9</range>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="TheShatteredCrown.CompProperties_TSC_MendWorst" />
      <li Class="TheShatteredCrown.CompProperties_TSC_Vfx">
        <color>(1, 0.92, 0.6)</color>
        <scale>1.6</scale>
      </li>
    </comps>
  </AbilityDef>

  <!-- The Baron's plate: five years of sleeping beside the shard soaked
       into his iron. It weighs nothing to the wearer, turns steel like a
       fortress wall, and holds warmth like a hearth stone - the one piece
       of the hoard that was USED instead of counted. Unique: only the
       Baron spawns in it, and it comes off him untainted (the iron does
       not care who wears it; it has stopped caring about most things). -->
  <ThingDef ParentName="ApparelBase">
    <defName>TSC_Apparel_BaronPlate</defName>
    <label>the Baron's plate</label>
    <description>Overlapping plates of grey iron, mended by hands that knew how, worn every day for five years by a man who slept beside something that hums. The metal has learned things iron should not know: it sits on the shoulders like wool, sheds winter like a hearth stone, and turns a blade with a sound like a struck bell heard from far away.\n\nIt does not rust, and it does not care who wears it.</description>
    <techLevel>Medieval</techLevel>
    <smeltable>false</smeltable>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/PlateArmor/PlateArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(70,74,86)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>360</MaxHitPoints>
      <Mass>6</Mass>
      <ArmorRating_Sharp>1.10</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.48</ArmorRating_Blunt>
      <ArmorRating_Heat>0.55</ArmorRating_Heat>
      <Insulation_Cold>40</Insulation_Cold>
      <Insulation_Heat>8</Insulation_Heat>
      <EquipDelay>10</EquipDelay>
      <MarketValue>1850</MarketValue>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <equippedStatOffsets>
      <!-- The magic is what is MISSING: plate's -0.8 move is not here.
           The iron does not remember being heavy. -->
      <PainShockThreshold>0.10</PainShockThreshold>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <tradeability>Sellable</tradeability>
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/PlateArmor/PlateArmor</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <careIfWornByCorpse>false</careIfWornByCorpse>
    </apparel>
    <colorGenerator Class="ColorGenerator_Single">
      <color>(70,74,86)</color>
    </colorGenerator>
  </ThingDef>

  <!-- The Baron: the Iron Brand's lord, posted on his hoard with his
       bodyguard (GenStep_TSC_IronBrandHoard). Heavy melee, the best steel
       banditry buys, and his own plate on his back. -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_IronBrandBaron</defName>
    <label>the Bandit Baron</label>
    <combatPower>220</combatPower>
    <itemQuality>Excellent</itemQuality>
    <isFighter>true</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeAdvanced</li>
    </weaponTags>
    <weaponMoney>500~800</weaponMoney>
    <apparelRequired>
      <li>TSC_Apparel_BaronPlate</li>
    </apparelRequired>
  </PawnKindDef>

  <!-- The keep site. -->
  <SitePartDef>
    <defName>TSC_IronBrandKeep</defName>
    <label>Iron Brand keep</label>
    <description>A keep of the old kingdom on a hard hill, held by the Iron Brand: a bandit company grown fat enough to fly banners. The walls are patched but the gate is iron, and the garrison has good steel. Somewhere under their hoard lies what the shards showed.</description>
    <siteTexture>World/WorldObjects/TSC_Sites/TSC_SiteKeep</siteTexture>
    <expandingIconTexture>World/WorldObjects/TSC_Sites/TSC_SiteKeep</expandingIconTexture>
    <approachOrderString>Assault {0}</approachOrderString>
    <approachingReportString>Approaching {0}.</approachingReportString>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
    <wantsThreatPoints>true</wantsThreatPoints>
    <minThreatPoints>300</minThreatPoints>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
    <tags>
      <li>TSC_IronBrandKeep</li>
    </tags>
    <modExtensions>
      <li Class="TheShatteredCrown.TSC_PersistentSiteExtension">
        <whileQuestActive>TSC_Act3_IronBrand</whileQuestActive>
      </li>
    </modExtensions>
  </SitePartDef>

  <!-- The keep itself: ONE structure at the map's heart, not vanilla's
       scattered ruin regions (GenStep_AncientRuins drops several
       disconnected fragments around the map, which is why this used to read
       as a generic ruin instead of somebody's seat). -->
  <GenStepDef>
    <defName>TSC_IronBrandKeep_Structure</defName>
    <linkWithSite>TSC_IronBrandKeep</linkWithSite>
    <order>470</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_Layout">
      <layoutDef>TSC_KeepCastle</layoutDef>
      <size>44</size>
    </genStep>
  </GenStepDef>

  <!-- The curtain wall around it: towers, one iron gate, a flagstone yard,
       and a few stretches that fell and were never rebuilt. -->
  <GenStepDef>
    <defName>TSC_IronBrandKeep_Curtain</defName>
    <linkWithSite>TSC_IronBrandKeep</linkWithSite>
    <order>472</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_Curtain" />
  </GenStepDef>

  <!-- The vault: Baron, bodyguard, hoard, and the shard, in the deepest
       room the layout built. Runs before the garrison so the wall guards
       never soak up the vault cells. -->
  <GenStepDef>
    <defName>TSC_IronBrandKeep_Hoard</defName>
    <linkWithSite>TSC_IronBrandKeep</linkWithSite>
    <order>480</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_IronBrandHoard" />
  </GenStepDef>

  <!-- The garrison: the walls are manned. Scaled to the party like every
       held site; the hexer is the Brand's pet reader of stolen books. -->
  <GenStepDef>
    <defName>TSC_IronBrandKeep_Garrison</defName>
    <linkWithSite>TSC_IronBrandKeep</linkWithSite>
    <order>483</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_BanditGuards">
      <count>6~8</count>
      <scaledClamp>4~12</scaledClamp>
      <kinds>
        <li>TSC_Bandit_Brigand</li>
        <li>TSC_Bandit_Archer</li>
        <li>TSC_BanditHexer</li>
      </kinds>
    </genStep>
  </GenStepDef>


  <!-- ================================================================
       Act 3 lead-in content: Madoc, Thornden, the Brand outpost.
       Quest chain in QuestScripts/TSC_Act3_Quests.xml.
       ================================================================ -->

  <!-- Madoc Emberlow: the sorcerer at the fire on the road. Joinable. -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Companion_Madoc</defName>
    <label>sorcerer</label>
    <combatPower>90</combatPower>
    <isFighter>false</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_Madoc</dialogue>
        <initiations>
          <li>
            <!-- The door swings both ways: a companion who has gone cold on
                 this company asks to be let go. Persuasion can buy one stay
                 (Dialogues/part_ways_ask.agd). -->
            <dialogue>TSC_Dialogue_PartWaysAsk</dialogue>
            <mtbDays>4</mtbDays>
            <once>true</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_Affinity">
                <max>-1</max>
              </li>
            </conditions>
          </li>
          <!-- His companion quest. Gated on the camp talk, where he first
               admits out loud that what he hears in the fire is the shape
               they left in him rather than the men: he does not open this
               with people who have not already heard that. -->
          <li>
            <dialogue>TSC_Dialogue_MadocFire</dialogue>
            <mtbDays>1.5</mtbDays>
            <once>true</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_FlagSet">
                <flag>TSC_MadocCampTalk</flag>
              </li>
            </conditions>
          </li>
        </initiations>
      </li>
    </modExtensions>
  </PawnKindDef>

  <TheShatteredCrown.NamedNpcDef>
    <defName>TSC_Npc_Madoc</defName>
    <label>Madoc Emberlow</label>
    <description>A sorcerer met at a campfire on the road to the Iron Brand keep, keeping counsel with two companions who no longer answer. Mad as a spring hare, friendly as a dog, and better with fire than anyone sane.</description>
    <firstName>Madoc</firstName>
    <lastName>Emberlow</lastName>
    <kind>TSC_Companion_Madoc</kind>
    <gender>Male</gender>
    <classDef>TSC_Class_Sorcerer</classDef>
    <startingLevel>3</startingLevel>
    <plotArmor>true</plotArmor>
    <combatBarks>
      <li>The fire says hello!</li>
      <li>Singing helps! It keeps the fire company!</li>
      <li>Hew thinks this is too loud! Hew is RIGHT!</li>
      <li>Not that one, that one is MINE!</li>
      <li>Burning is a CONVERSATION!</li>
      <li>Gille would have smelled this coming!</li>
      <li>The fire is VERY excited!</li>
      <li>You would burn beautifully, but not today!</li>
      <li>Hew says duck! I never argue with Hew!</li>
      <li>Ash is only applause that settled!</li>
    </combatBarks>
  </TheShatteredCrown.NamedNpcDef>

  <!-- The tribute collector: the Brand's polite face in Thornden square. -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Brand_Collector</defName>
    <label>Brand collector</label>
    <combatPower>90</combatPower>
    <itemQuality>Good</itemQuality>
    <isFighter>true</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeAdvanced</li>
    </weaponTags>
    <weaponMoney>250~450</weaponMoney>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_BrandCollectors</dialogue>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- Thornden's residents -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Villager_Hedda</defName>
    <label>reeve</label>
    <combatPower>25</combatPower>
    <isFighter>false</isFighter>
    <invFoodDef>Pemmican</invFoodDef>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_Hedda</dialogue>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Villager_Garrick</defName>
    <label>smith</label>
    <combatPower>40</combatPower>
    <isFighter>false</isFighter>
    <invFoodDef>Pemmican</invFoodDef>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_Garrick</dialogue>
      </li>
    </modExtensions>
  </PawnKindDef>

  <TheShatteredCrown.NamedNpcDef>
    <defName>TSC_Npc_Hedda</defName>
    <label>Hedda Rill</label>
    <description>Reeve of Thornden, keeper of a ledger the Iron Brand fills faster than the harvest does.</description>
    <firstName>Hedda</firstName>
    <lastName>Rill</lastName>
    <kind>TSC_Villager_Hedda</kind>
    <gender>Female</gender>
  </TheShatteredCrown.NamedNpcDef>

  <TheShatteredCrown.NamedNpcDef>
    <defName>TSC_Npc_Garrick</defName>
    <label>Garrick Coalhand</label>
    <description>Thornden's smith. The Iron Brand holds his son Bry as surety for the village's tribute.</description>
    <firstName>Garrick</firstName>
    <lastName>Coalhand</lastName>
    <kind>TSC_Villager_Garrick</kind>
    <gender>Male</gender>
  </TheShatteredCrown.NamedNpcDef>

  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Villager_Odo</defName>
    <label>old man</label>
    <combatPower>15</combatPower>
    <isFighter>false</isFighter>
    <invFoodDef>Pemmican</invFoodDef>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_Odo</dialogue>
      </li>
    </modExtensions>
  </PawnKindDef>

  <TheShatteredCrown.NamedNpcDef>
    <defName>TSC_Npc_Odo</defName>
    <label>Odo Larkin</label>
    <description>The old man on the kerb of Thornden's well. He has watched every tribute day for five years on the grounds that somebody ought to.</description>
    <firstName>Odo</firstName>
    <lastName>Larkin</lastName>
    <kind>TSC_Villager_Odo</kind>
    <gender>Male</gender>
    <biologicalAge>71</biologicalAge>
    <!-- The square is his whole routine: he must be where the player looks
         after the collectors are answered, not off at a work spot. -->
    <homebody>true</homebody>
    <plotArmor>true</plotArmor>
  </TheShatteredCrown.NamedNpcDef>

  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Villager_Bry</defName>
    <label>smith's apprentice</label>
    <combatPower>20</combatPower>
    <isFighter>false</isFighter>
    <invFoodDef>Pemmican</invFoodDef>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_Bry</dialogue>
      </li>
    </modExtensions>
  </PawnKindDef>

  <TheShatteredCrown.NamedNpcDef>
    <defName>TSC_Npc_Bry</defName>
    <label>Bry Coalhand</label>
    <description>The Thornden smith's son, fifteen, taken by the Iron Brand as surety on the village's tribute. He went quiet so they would have no reason to be rough, and waved from the bend in the road.</description>
    <firstName>Bry</firstName>
    <lastName>Coalhand</lastName>
    <kind>TSC_Villager_Bry</kind>
    <gender>Male</gender>
    <biologicalAge>15</biologicalAge>
    <plotArmor>true</plotArmor>
    <!-- Away machinery: the act flag is set before Thornden can exist, so
         Bry never spawns at the smithy while captive; the Surety quest's
         success brings him home on the next village visit. -->
    <awayIfFlag>TSC_ShardRush2Seen</awayIfFlag>
    <backAfterQuest>TSC_Act3_Surety</backAfterQuest>
  </TheShatteredCrown.NamedNpcDef>

  <!-- The fire on the road: Madoc's camp. Peaceful site, one scene. -->
  <SitePartDef>
    <defName>TSC_RoadFire</defName>
    <label>fire on the road</label>
    <description>A thin line of woodsmoke off the road toward the Iron Brand's hills. Scouts say one man, talking as if to company.</description>
    <siteTexture>World/WorldObjects/TSC_Sites/TSC_SiteCamp</siteTexture>
    <expandingIconTexture>World/WorldObjects/TSC_Sites/TSC_SiteCamp</expandingIconTexture>
    <approachOrderString>Approach {0}</approachOrderString>
    <approachingReportString>Approaching {0}.</approachingReportString>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
    <tags>
      <li>TSC_RoadFire</li>
    </tags>
    <modExtensions>
      <li Class="TheShatteredCrown.TSC_PersistentSiteExtension">
        <whileQuestActive>TSC_Act3_RoadFire</whileQuestActive>
        <noDetectionRaids>true</noDetectionRaids>
      </li>
    </modExtensions>
  </SitePartDef>

  <GenStepDef>
    <defName>TSC_RoadFire</defName>
    <linkWithSite>TSC_RoadFire</linkWithSite>
    <order>480</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_RoadFire" />
  </GenStepDef>

  <!-- Thornden: the village under the Brand's thumb. Reuses the Act 1
       village machinery: a household and the smithy, tribute collectors
       in the square until the question is answered. -->
  <SitePartDef>
    <defName>TSC_ThorndenVillage</defName>
    <label>Thornden</label>
    <description>A farming village in the shadow of the Iron Brand keep. It pays for the privilege.</description>
    <siteTexture>World/WorldObjects/TSC_Sites/TSC_SiteVillage</siteTexture>
    <expandingIconTexture>World/WorldObjects/TSC_Sites/TSC_SiteVillage</expandingIconTexture>
    <approachOrderString>Visit {0}</approachOrderString>
    <approachingReportString>Travelling to {0}.</approachingReportString>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
    <tags>
      <li>TSC_ThorndenVillage</li>
    </tags>
    <modExtensions>
      <!-- Story hub, like Harrowfield: persists for good. Bry comes home
           here, and Garrick's forge stays lit through the act. -->
      <li Class="TheShatteredCrown.TSC_PersistentSiteExtension">
        <noDetectionRaids>true</noDetectionRaids>
      </li>
    </modExtensions>
  </SitePartDef>

  <GenStepDef>
    <defName>TSC_ThorndenVillage</defName>
    <linkWithSite>TSC_ThorndenVillage</linkWithSite>
    <order>470</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_Village">
      <well>TSC_Well</well>
      <squareResident>TSC_Npc_Odo</squareResident>
      <fence>Fence</fence>
      <fenceGate>FenceGate</fenceGate>
      <fenceStuff>WoodLog</fenceStuff>
      <buildings>
        <li>
          <prefab>TSC_Cottage</prefab>
          <cropField>true</cropField>
          <resident>TSC_Npc_Hedda</resident>
          <fillerCount>1~2</fillerCount>
        </li>
        <li>
          <prefab>TSC_Smithy</prefab>
          <residents>
            <li>TSC_Npc_Garrick</li>
            <li>TSC_Npc_Bry</li>
          </residents>
        </li>
        <!-- The village the reeve reeves and the smith smiths for:
             two farm households of background folk. -->
        <li>
          <prefab>TSC_Cottage</prefab>
          <cropField>true</cropField>
          <fillerCount>2~3</fillerCount>
          <livestock>
            <li>
              <kind>Chicken</kind>
              <count>2~4</count>
            </li>
          </livestock>
        </li>
        <li>
          <prefab>TSC_CottageSmall</prefab>
          <cropField>true</cropField>
          <fillerCount>1~2</fillerCount>
          <livestock>
            <li>
              <kind>Goat</kind>
              <count>1~2</count>
            </li>
          </livestock>
        </li>
      </buildings>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_ThorndenCollectors</defName>
    <linkWithSite>TSC_ThorndenVillage</linkWithSite>
    <order>485</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_ThorndenCollectors" />
  </GenStepDef>

  <!-- The Brand outpost holding Garrick's son: the surety. Contract-rescue
       machinery with Brand colors. -->
  <SitePartDef>
    <defName>TSC_BrandOutpost</defName>
    <label>Brand outpost</label>
    <description>A watch-camp of the Iron Brand in the hills below the keep. This is where they keep what they take as surety.</description>
    <siteTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</siteTexture>
    <expandingIconTexture>World/WorldObjects/TSC_Sites/TSC_SiteRuin</expandingIconTexture>
    <approachOrderString>Raid {0}</approachOrderString>
    <approachingReportString>Travelling to {0}.</approachingReportString>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
    <wantsThreatPoints>true</wantsThreatPoints>
    <minThreatPoints>160</minThreatPoints>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
    <tags>
      <li>TSC_BrandOutpost</li>
    </tags>
    <modExtensions>
      <li Class="TheShatteredCrown.TSC_PersistentSiteExtension">
        <whileQuestActive>TSC_Act3_Surety</whileQuestActive>
      </li>
    </modExtensions>
  </SitePartDef>

  <!-- One watch-house, not vanilla's field of scattered ruin fragments
       (GenStep_AncientRuins drops several disconnected pieces across the
       map, which is why this read as an archaeological dig rather than a
       camp somebody is holding a boy in). -->
  <GenStepDef>
    <defName>TSC_BrandOutpost_Structure</defName>
    <linkWithSite>TSC_BrandOutpost</linkWithSite>
    <order>470</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_Layout">
      <layoutDef>TSC_Waystation</layoutDef>
      <size>26</size>
    </genStep>
  </GenStepDef>

  <!-- A timber palisade with a barred gate: what a bandit watch-camp throws
       up in a week. No battlements, no towers, no masonry - it should read
       as a camp that is HELD, and never be mistaken for the keep. -->
  <GenStepDef>
    <defName>TSC_BrandOutpost_Palisade</defName>
    <linkWithSite>TSC_BrandOutpost</linkWithSite>
    <order>472</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_Curtain">
      <margin>6</margin>
      <wallStuff>WoodLog</wallStuff>
      <gateStuff>WoodLog</gateStuff>
      <crenellated>false</crenellated>
      <towers>false</towers>
      <breaches>1~2</breaches>
      <breachLength>1~2</breachLength>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_BrandOutpost_Captive</defName>
    <linkWithSite>TSC_BrandOutpost</linkWithSite>
    <order>480</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_Captive">
      <npc>TSC_Npc_Bry</npc>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_BrandOutpost_Guards</defName>
    <linkWithSite>TSC_BrandOutpost</linkWithSite>
    <order>483</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_BanditGuards">
      <count>5~8</count>
      <scaledClamp>4~11</scaledClamp>
      <!-- No explicit roster: the default crew brings its own hexers,
           scaled to the party. -->
    </genStep>
  </GenStepDef>

  <!-- Gille's drain: the back way into the keep, carved only once the
       party has heard of it (TSC_BrandBackWay, from Madoc's scene).
       Order 490: after the castle and its hoard, before vanilla Fog. -->
  <GenStepDef>
    <defName>TSC_IronBrandKeep_BackWay</defName>
    <linkWithSite>TSC_IronBrandKeep</linkWithSite>
    <order>490</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_KeepDrain">
      <grateDef>TSC_KeepDrainGrate</grateDef>
    </genStep>
  </GenStepDef>

  <!-- ================================================================
       Gille's drain: the way under the walls, and a ONE-WAY one.

       The undercellar has a single portal and it stands inside the keep,
       so the cave exit at the bottom of that stair comes up behind the
       curtain. The party gets in through the grate below, which drops
       them at the far end of the cellar and does not open again.
       ================================================================ -->

  <!-- The grate: no portal, just a thing that talks. Walking up to it
       opens the conversation that offers the descent, and the warning. -->
  <ThingDef ParentName="BuildingBase">
    <defName>TSC_KeepDrainGrate</defName>
    <label>drain grate</label>
    <description>A stone throat in the hillside east of the keep, grated once and not for a long time. The old kingdom drained its cellars into this. The bars are gone at one corner and the gap is a body wide, and the air coming out of it is colder than the day.</description>
    <thingClass>TheShatteredCrown.Building_TSC_DrainGrate</thingClass>
    <size>(2,2)</size>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/CaveEntranceA</texPath>
      <drawSize>(2,2)</drawSize>
      <color>(96,92,84)</color>
    </graphicData>
    <comps>
      <li Class="TheShatteredCrown.CompProperties_TSC_ProximityDialogue">
        <dialogue>TSC_Dialogue_KeepDrain</dialogue>
        <radius>5.9</radius>
      </li>
    </comps>
  </ThingDef>

  <!-- The stair inside the keep: the cellar's one and only portal, so the
       cave exit down there pairs with THIS and comes up behind the wall. -->
  <ThingDef ParentName="TSC_CellarStairsBase">
    <defName>TSC_KeepCellarStair</defName>
    <label>cellar stair</label>
    <description>A shaft of worked steps going down under the keep, ending in water somewhere below. The Brand stores what it does not want seen down there, and stopped counting what else might be.</description>
    <size>(2,2)</size>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/TSC_StoneStairs</texPath>
      <drawSize>(2,2)</drawSize>
      <color>(120,112,98)</color>
    </graphicData>
    <portal>
      <pocketMapGenerator>TSC_Keep_Undercellar</pocketMapGenerator>
      <exitDef>TSC_StairsUp</exitDef>
      <pocketMapSize>80</pocketMapSize>
    </portal>
  </ThingDef>

  <GenStepDef>
    <defName>TSC_IronBrandKeep_CellarStair</defName>
    <linkWithSite>TSC_IronBrandKeep</linkWithSite>
    <order>492</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_KeepCellarStair">
      <stairDef>TSC_KeepCellarStair</stairDef>
    </genStep>
  </GenStepDef>

  <MapGeneratorDef ParentName="TSC_CellarLevelBase">
    <defName>TSC_Keep_Undercellar</defName>
    <label>the keep undercellar</label>
    <genSteps>
      <li>ElevationFertility</li>
      <li>MutatorPostElevationFertility</li>
      <li>Underground_RocksFromGrid</li>
      <li>Terrain</li>
      <li>MutatorPostTerrain</li>
      <li>RockChunks</li>
      <li>PlaceCaveExit</li>
      <li>TSC_KeepUndercellar</li>
      <li>TSC_KeepUndercellarCache</li>
      <li>TSC_KeepUndercellarCrates</li>
      <li>MutatorFinal</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>TSC_KeepUndercellar</defName>
    <order>551</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_CellarLevel">
      <level>1</level>
      <layoutDef>TSC_Catacombs</layoutDef>
      <size>40</size>
      <!-- NO dormant nests. The catacomb layout rolls insect clusters per
           gallery, which is right for a delve the party chose to plumb and
           wrong here: this is the EASY road in, bought with a one-way trip
           and a scouting scene, and it must stay cheaper than the gate. The
           budget prunes every dormant pack the layout leaves. -->
      <maxDormantPacks>0</maxDormantPacks>
      <!-- Lightly held on purpose. A couple of Brand storemen who are not
           expecting the stairs to be used, or a few things living in the
           water - never a floor fight. The garrison above is the fight. -->
      <occupants>
        <li>
          <weight>2</weight>
          <faction>bandits</faction>
          <kinds>
            <li>TSC_Bandit_Brigand</li>
          </kinds>
          <count>2~3</count>
          <arrivalNote>Somebody is down here, and they are not expecting the stairs to be used.</arrivalNote>
        </li>
        <li>
          <weight>1</weight>
          <faction>wild</faction>
          <kinds>
            <li>Rat</li>
          </kinds>
          <count>1~3</count>
          <arrivalNote>The drain has tenants: rats, sleek on whatever the Brand throws away. They were here before the Brand and they will be here after.</arrivalNote>
        </li>
      </occupants>
      <spots>
        <li>TSC_BrandStrongbox</li>
      </spots>
    </genStep>
  </GenStepDef>

  <!-- What the Brand keeps out of sight: the reason the drain route pays
       for itself rather than just arriving early and poor. Worth well less
       than the vault - the hoard upstairs is still the prize. -->
  <!-- The Brand's own box. Locked, because a company that steals for a
       living locks up what it stole: Thievery to pick it quietly, Athletics
       to pry it loud, the same pair every sealed chest in the mod offers. -->
  <ThingDef ParentName="AncientSealedCrateBase">
    <defName>TSC_BrandStrongbox</defName>
    <label>banded strongbox</label>
    <description>An iron-banded box with the Brand's mark burned into the lid, sat in the wet where nobody upstairs has to look at it. Whatever is in it was taken off somebody, and then taken off whoever took it off them.</description>
    <comps>
      <li Class="CompProperties_LootSpawn">
        <contents>TSC_Loot_CommonCache</contents>
      </li>
      <li Class="TheShatteredCrown.CompProperties_TSC_CheckSpot">
        <approaches>
          <li>
            <proficiency>TSC_Prof_Thievery</proficiency>
            <dc>8</dc>
            <label>Pick the lock (quiet)</label>
            <successOpens>true</successOpens>
            <successXp>25</successXp>
            <successMessage>The lock gives without a sound. Nothing upstairs has any reason to look at the floor.</successMessage>
            <failOpens>true</failOpens>
            <failWakesDormant>true</failWakesDormant>
            <failMessage>The pick slips and the lid bangs back, and the noise goes up the stair ahead of you.</failMessage>
          </li>
          <li>
            <proficiency>TSC_Prof_Athletics</proficiency>
            <dc>7</dc>
            <label>Pry it open (loud)</label>
            <successOpens>true</successOpens>
            <successWakesDormant>true</successWakesDormant>
            <successXp>15</successXp>
            <successMessage>The bands come away with a crack that rolls off the wet stone and keeps going.</successMessage>
            <failMessage>The bar bends; the lid does not. Whatever is inside stays there.</failMessage>
          </li>
        </approaches>
      </li>
    </comps>
  </ThingDef>

  <!-- The stack at the foot of the stair, and the plan it suggests. -->
  <ThingDef ParentName="BuildingBase">
    <defName>TSC_CellarCrates</defName>
    <label>stacked stores</label>
    <description>Barrels and crates stacked four high against the wall by the stair: salt fish, and something that used to be flour. The Brand has been putting its stores down here for five years and carrying them back up the same steps.</description>
    <thingClass>TheShatteredCrown.Building_TSC_CellarCrates</thingClass>
    <size>(2,2)</size>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/TSC_LootChest</texPath>
      <drawSize>(2,2)</drawSize>
      <color>(150,128,96)</color>
    </graphicData>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <li Class="TheShatteredCrown.CompProperties_TSC_ProximityDialogue">
        <dialogue>TSC_Dialogue_CellarCrates</dialogue>
        <radius>6.9</radius>
      </li>
    </comps>
  </ThingDef>

  <!-- The push itself: ordered by right-click after the crates scene makes
       the plan, so the company takes positions before the noise starts. -->
  <JobDef>
    <defName>TSC_TipCrates</defName>
    <driverClass>TheShatteredCrown.JobDriver_TSC_TipCrates</driverClass>
    <reportString>pushing the stack over.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <GenStepDef>
    <defName>TSC_KeepUndercellarCrates</defName>
    <order>558</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_CellarCrates">
      <crateDef>TSC_CellarCrates</crateDef>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_KeepUndercellarCache</defName>
    <order>555</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_KeepCellarCache">
      <chestDef>TSC_BrandStrongbox</chestDef>
      <chests>2</chests>
      <silverStacks>1~2</silverStacks>
      <silverPerStack>60~140</silverPerStack>
    </genStep>
  </GenStepDef>

</Defs>
