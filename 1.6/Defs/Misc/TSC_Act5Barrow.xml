<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ================================================================
       Act 5's finale: inside the Barrow of Kings.

       The shape is a PROCESSION: one long hall from the stair to the
       throne room, the five road panels in wall niches along it (one
       proficiency each, the payoff for four acts of collected
       knowledge), and nothing hostile before the chamber door. The
       crown starts bargaining on the descent; the Honor Guard
       challenges rather than charges; the sarcophagus offers a CHOICE,
       not a pickup.
       ================================================================ -->

  <!-- The mound's stone throat, on the surface site. -->
  <ThingDef ParentName="BuildingBase">
    <defName>TSC_KingsBarrowMouth</defName>
    <label>the barrow mouth</label>
    <description>A throat of dressed stone facing the sunrise, cut by hands that predate every kingdom on the maps. The dark inside it is not cold. The four pieces in the company's packs have stopped humming and started listening.</description>
    <size>(6,6)</size>
    <useHitPoints>false</useHitPoints>
    <thingClass>TheShatteredCrown.Building_TSC_BarrowEntrance</thingClass>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <canOverlapZones>false</canOverlapZones>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/TSC_StoneStairs</texPath>
      <drawSize>(6,6)</drawSize>
      <color>(122,124,116)</color>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <fillPercent>0</fillPercent>
    <passability>Impassable</passability>
    <holdsRoof>true</holdsRoof>
    <destroyable>false</destroyable>
    <building>
      <isEdifice>true</isEdifice>
      <deconstructible>false</deconstructible>
      <isTargetable>false</isTargetable>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <portal>
      <pocketMapGenerator>TSC_KingsBarrow_Interior</pocketMapGenerator>
      <exitDef>TSC_StairsUp</exitDef>
      <pocketMapSize>90</pocketMapSize>
    </portal>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <inspectorTabs>
      <li>ITab_ContentsMapPortal</li>
    </inspectorTabs>
  </ThingDef>

  <!-- The mound the arrival letter describes: a long green barrow with a
       granite curb, and the throat set in its east end facing sunrise. -->
  <GenStepDef>
    <defName>TSC_FirstKingBarrow_Mound</defName>
    <linkWithSite>TSC_FirstKingBarrow</linkWithSite>
    <order>476</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_Mound">
      <mouthDef>TSC_KingsBarrowMouth</mouthDef>
      <length>34</length>
      <width>18</width>
    </genStep>
  </GenStepDef>

  <!-- ============================================ the interior -->

  <MapGeneratorDef ParentName="TSC_CellarLevelBase">
    <defName>TSC_KingsBarrow_Interior</defName>
    <label>the Barrow of Kings</label>
    <genSteps>
      <li>ElevationFertility</li>
      <li>MutatorPostElevationFertility</li>
      <li>Underground_RocksFromGrid</li>
      <li>Terrain</li>
      <li>MutatorPostTerrain</li>
      <li>RockChunks</li>
      <!-- NO PlaceCaveExit: that vanilla genstep ignores the portal's
           exitDef and spawns a hardcoded CaveExit at a random cell,
           which put a second, stray way up in a side cave. The hall
           genstep spawns the real TSC_StairsUp at the hall's head. -->
      <li>TSC_KingsBarrowLevel</li>
      <li>TSC_KingsBarrowThrone</li>
      <li>MutatorFinal</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <!-- One long hall, stair to king: the five road panels stand in wall
       niches down its length (the genstep places them, dust line first),
       and nothing hostile spawns before the throne room's door. -->
  <GenStepDef>
    <defName>TSC_KingsBarrowLevel</defName>
    <order>551</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_KingsHall" />
  </GenStepDef>

  <GenStepDef>
    <defName>TSC_KingsBarrowThrone</defName>
    <order>556</order>
    <genStep Class="TheShatteredCrown.GenStep_TSC_ThroneRoom">
      <!-- Five, exactly: five roads went out of this barrow and five men
           were left standing at the door, and if the company sends the crown
           out again it is these five who carry it. -->
      <guards>5~5</guards>
    </genStep>
  </GenStepDef>

  <!-- The king's door: the throne room's threshold, sealed until the
       regalia is carried. Walking up to it fires the sealers' riddle
       (TSC_Dialogue_KingsDoor), which is what grants the regalia quest:
       the mound names its own price, at its own door. -->
  <ThingDef ParentName="Door">
    <defName>TSC_KingsDoor</defName>
    <label>the king's door</label>
    <description>A door of dressed stone with no bar and no seam wide enough for a knife. Three shallow indentations are set into its face - a circle, a disc, a crescent - and above them, in deep-cut lines, the sealers left their riddle. It was not made to be forced. It was made to be answered.</description>
    <thingClass>TheShatteredCrown.Building_TSC_KingsDoor</thingClass>
    <designationCategory Inherit="False" />
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
    </statBases>
  </ThingDef>

  <!-- ============================================ the five roads -->

  <ThingDef Name="TSC_RoadStoneBase" ParentName="BuildingBase" Abstract="True">
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.3</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/TSC_GravenStone</texPath>
      <drawSize>(1.3,1.3)</drawSize>
      <color>(150,148,140)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>0</WorkToBuild>
    </statBases>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
  </ThingDef>

  <ThingDef ParentName="TSC_RoadStoneBase">
    <defName>TSC_Road_Grave</defName>
    <label>the first road</label>
    <description>A carved panel in a wall niche: five riders leaving a burning hall, each on a different road. This one runs north, into hill country.</description>
    <comps>
      <li Class="TheShatteredCrown.CompProperties_TSC_CheckSpot">
        <approaches>
          <li>
            <proficiency>TSC_Prof_Lore</proficiency>
            <dc>12</dc>
            <noScaling>true</noScaling>
            <label>Read the first road</label>
            <failAllowsRetry>true</failAllowsRetry>
            <successXp>40</successXp>
            <successFlag>TSC_Road_Grave</successFlag>
            <successDialogue>TSC_Dialogue_RoadGrave</successDialogue>
            <successMessage>The first road opens under the lamp: the rider who dug a grave and lay down in it.</successMessage>
            <failMessage>The panel is worn past reading in this light.</failMessage>
          </li>
        </approaches>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="TSC_RoadStoneBase">
    <defName>TSC_Road_Reliquary</defName>
    <label>the second road</label>
    <description>A carved panel showing a rider going down: stairs, then water, then stairs again.</description>
    <comps>
      <li Class="TheShatteredCrown.CompProperties_TSC_CheckSpot">
        <approaches>
          <li>
            <proficiency>TSC_Prof_Arcana</proficiency>
            <dc>12</dc>
            <noScaling>true</noScaling>
            <label>Read the second road</label>
            <failAllowsRetry>true</failAllowsRetry>
            <successXp>40</successXp>
            <successFlag>TSC_Road_Reliquary</successFlag>
            <successDialogue>TSC_Dialogue_RoadReliquary</successDialogue>
            <successMessage>The sigils resolve: the road under the city, and the singer at the bottom of it.</successMessage>
            <failMessage>The sigils along the panel refuse to resolve.</failMessage>
          </li>
        </approaches>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="TSC_RoadStoneBase">
    <defName>TSC_Road_Hoard</defName>
    <label>the third road</label>
    <description>A carved panel of a rider going east into hard hills, and of the hands the piece passed through afterward.</description>
    <comps>
      <li Class="TheShatteredCrown.CompProperties_TSC_CheckSpot">
        <approaches>
          <li>
            <proficiency>TSC_Prof_Investigation</proficiency>
            <dc>12</dc>
            <noScaling>true</noScaling>
            <label>Read the third road</label>
            <failAllowsRetry>true</failAllowsRetry>
            <successXp>40</successXp>
            <successFlag>TSC_Road_Hoard</successFlag>
            <successDialogue>TSC_Dialogue_RoadHoard</successDialogue>
            <successMessage>The sequence comes clear: follow the piece, not the man.</successMessage>
            <failMessage>The lower panels are cracked through and the sequence breaks.</failMessage>
          </li>
        </approaches>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="TSC_RoadStoneBase">
    <defName>TSC_Road_Quiet</defName>
    <label>the fourth road</label>
    <description>A carved panel of a rider arriving at a walled house in winter, and of the house afterward.</description>
    <comps>
      <li Class="TheShatteredCrown.CompProperties_TSC_CheckSpot">
        <approaches>
          <li>
            <proficiency>TSC_Prof_Insight</proficiency>
            <dc>12</dc>
            <noScaling>true</noScaling>
            <label>Read the fourth road</label>
            <failAllowsRetry>true</failAllowsRetry>
            <successXp>40</successXp>
            <successFlag>TSC_Road_Quiet</successFlag>
            <successDialogue>TSC_Dialogue_RoadQuiet</successDialogue>
            <successMessage>The winter road reads at last, and the part underneath is not a prophecy. It is an instruction.</successMessage>
            <failMessage>Frost damage has taken the lower half of the panel.</failMessage>
          </li>
        </approaches>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="TSC_RoadStoneBase">
    <defName>TSC_Road_Last</defName>
    <label>the fifth road</label>
    <description>A carved panel with a rider on it and no destination: the road runs off the edge of the stone and does not arrive anywhere.</description>
    <comps>
      <li Class="TheShatteredCrown.CompProperties_TSC_CheckSpot">
        <approaches>
          <li>
            <proficiency>TSC_Prof_Perception</proficiency>
            <dc>12</dc>
            <noScaling>true</noScaling>
            <label>Read the fifth road</label>
            <failAllowsRetry>true</failAllowsRetry>
            <successXp>50</successXp>
            <successFlag>TSC_Road_Last</successFlag>
            <successDialogue>TSC_Dialogue_RoadLast</successDialogue>
            <successMessage>The fifth panel is not plain. It is unfinished, on purpose.</successMessage>
            <failMessage>The panel is the plainest of the five, and gives up nothing.</failMessage>
          </li>
        </approaches>
      </li>
    </comps>
  </ThingDef>

  <!-- ============================================ the Honor Guard -->

  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_HonorGuard</defName>
    <label>oath-keeper of the first king</label>
    <combatPower>180</combatPower>
    <itemQuality>Excellent</itemQuality>
    <isFighter>true</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeAdvanced</li>
    </weaponTags>
    <weaponMoney>600~900</weaponMoney>
    <apparelRequired>
      <li>Apparel_PlateArmor</li>
    </apparelRequired>
  </PawnKindDef>

  <!-- ============================================ the last courier -->

  <!-- Aled walks up the slope as the party arrives, hands over the fifth
       piece, and sits down facing the way he came. He is a real pawn so
       the scene has a face in it, and so the sitting down is something the
       player can watch rather than something the text asserts. -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Courier</defName>
    <label>courier</label>
    <combatPower>60</combatPower>
    <isFighter>false</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_LastCourier</dialogue>
      </li>
    </modExtensions>
  </PawnKindDef>

  <TheShatteredCrown.NamedNpcDef>
    <defName>TSC_Npc_Courier</defName>
    <label>Aled</label>
    <description>Courier of the crown of Aldruin, fifth road, eight hundred and eleven years out from a gate that is not there any more.</description>
    <firstName>Aled</firstName>
    <lastName>Fifth-Road</lastName>
    <kind>TSC_Courier</kind>
    <gender>Male</gender>
    <!-- He has walked through four companies who tried. He does not die
         at the door of the place he spent eight centuries reaching. -->
    <plotArmor>true</plotArmor>
  </TheShatteredCrown.NamedNpcDef>

  <!-- What the inspection shows. Applied at the handover, a moment before
       he dies of it, so the corpse a player clicks on carries the reason
       in its health tab instead of just being an unusually dry body. -->
  <HediffDef>
    <defName>TSC_Hediff_YearsCollected</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>eight hundred and eleven years</label>
    <description>The crown kept this man walking, and kept the bill. He set his piece down in somebody else's hands, and the whole account came due between one breath and the next: every year he should have aged, arriving at once.\n\nWhat is left is dry, light, and very old. It has been dead a long time. It only stopped moving recently.</description>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <defaultLabelColor>(0.72, 0.66, 0.5)</defaultLabelColor>
    <stages>
      <li>
        <lifeThreatening>true</lifeThreatening>
      </li>
    </stages>
  </HediffDef>

  <!-- ============================================ the tomb and the crown -->

  <ThingDef ParentName="BuildingBase">
    <defName>TSC_KingsSarcophagus</defName>
    <label>the first king's sarcophagus</label>
    <description>A single block of pale stone, lidded, unornamented except for a band cut around the head end: five points, one of them broken. The crown is older than the man inside. He only wore it first. Everything the shards have done for eight hundred years was aimed at getting somebody to stand exactly here.</description>
    <thingClass>TheShatteredCrown.Building_TSC_KingsTomb</thingClass>
    <size>(3,2)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.6</fillPercent>
    <useHitPoints>false</useHitPoints>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <altitudeLayer>Building</altitudeLayer>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/TSC_GraveMound</texPath>
      <drawSize>(3,2)</drawSize>
      <color>(198,194,184)</color>
    </graphicData>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
  </ThingDef>

  <JobDef>
    <defName>TSC_OpenKingsTomb</defName>
    <driverClass>TheShatteredCrown.JobDriver_TSC_OpenKingsTomb</driverClass>
    <reportString>opening the sarcophagus.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- The fifth shard: carried in by the last courier, not dug out of a
       wall. He hands it over, or he does not. -->
  <ThingDef ParentName="ResourceBase">
    <defName>TSC_CrownShard_Road</defName>
    <label>crown shard of the road</label>
    <description>A broken fifth of a king's crown: a curve of band and two points, worn smooth in places by eight hundred years of one man's hands. It is warm. One of five.\n\nIts gift is the road's own. The man who carried it walked eight hundred years without once being allowed to stop, through more than a body can, and settled up at the end. The shard still keeps that bargain for whoever holds it.</description>
    <graphicData>
      <texPath>Things/Item/TSC_CrownShard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <stackLimit>1</stackLimit>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <tradeability>None</tradeability>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <destroyOnDrop>false</destroyOnDrop>
    <statBases>
      <Mass>1.5</Mass>
      <MarketValue>2500</MarketValue>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <modExtensions>
      <li Class="TheShatteredCrown.TSC_ShardAbilityExtension">
        <ability>TSC_Ability_ErrandHolds</ability>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- The fifth shard's power: what it did to its couriers, on loan. One
       ally becomes unstoppable for a quarter minute - no downing, no
       stagger, no stun, no death, wounds wait - and when the errand ends
       the road takes its toll in months of their life, scaled to what
       they walked through. The player meets the crown's price mechanic
       here, in miniature, before the sarcophagus asks the big question.
       Cooldown belongs to the shard (NoteCast), like every shard power.
       No energy cost: it is not the pawn's magic. -->
  <AbilityDef ParentName="TSC_AbilityBase">
    <defName>TSC_Ability_ErrandHolds</defName>
    <label>the errand holds</label>
    <description>Lay the shard's warrant on one of the company. For a quarter of a minute the road carries them the way it carried its courier: they cannot be knocked down, staggered, stunned, or killed, and their wounds wait until the errand is done.\n\nThen the road settles up. The bearer ages a month for every ten points of harm they walked through. The shard allows this once in five days; carrying it is the only price.</description>
    <iconPath>UI/TSC_Abilities/TSC_ErrandHolds</iconPath>
    <cooldownTicksRange>300000</cooldownTicksRange>
    <stunTargetWhileCasting>false</stunTargetWhileCasting>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <warmupTime>1</warmupTime>
      <range>6.9</range>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="TheShatteredCrown.CompProperties_TSC_ErrandHolds">
        <hediff>TSC_Hediff_ErrandHolds</hediff>
      </li>
      <li Class="TheShatteredCrown.CompProperties_TSC_Vfx">
        <color>(1, 0.85, 0.5)</color>
        <scale>1.4</scale>
      </li>
    </comps>
  </AbilityDef>

  <HediffDef>
    <defName>TSC_Hediff_ErrandHolds</defName>
    <hediffClass>TheShatteredCrown.Hediff_TSC_ErrandHolds</hediffClass>
    <label>the errand holds</label>
    <description>The road shard's warrant. This one cannot be knocked down, staggered, stunned, or killed while it lasts, and their wounds wait. When it ends, the road takes its toll: a month of life for every ten points of harm walked through.</description>
    <defaultLabelColor>(1, 0.85, 0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>held</label>
        <painFactor>0</painFactor>
        <totalBleedFactor>0</totalBleedFactor>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_OngoingVfx">
        <fleck>MicroSparks</fleck>
        <color>(1, 0.85, 0.5)</color>
        <scale>0.6</scale>
        <interval>40</interval>
        <scatter>0.45</scatter>
      </li>
    </comps>
  </HediffDef>

  <!-- Whole. The campaign's last object, and only two endings produce it.

       APPAREL, not a resource: the crown answers to a wearer, and the game
       needs to know which head that is - the wishes are charged to whoever
       has it on. Take it off and the offer stops; hand it to somebody else
       and the next wish is spent out of their life instead. -->
  <ThingDef ParentName="ApparelBase">
    <defName>TSC_ShatteredCrown</defName>
    <label>the Shattered Crown</label>
    <description>Five pieces of a king's crown, together, and the seams are gone. It is warm, it is heavier than gold should be, and it is patient in the way of a thing that has just been proven right about everything.\n\nIt will give the wearer anything they ask for, as often as they ask, and it charges in years off their life in proportion to what they wanted. It does not come off a living head.\n\nIt is not shattered any more. Nobody has thought of a better name for it.</description>
    <graphicData>
      <texPath>Things/Item/TSC_CrownShard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.1</drawSize>
      <color>(255,220,130)</color>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <stackLimit>1</stackLimit>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <tradeability>None</tradeability>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <destroyOnDrop>false</destroyOnDrop>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <layers>
        <li>Overhead</li>
      </layers>
      <!-- Borrowed geometry: a banded circlet with points, which is what a
           headdress silhouette reads as once it is gold. -->
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/TribalHeaddress/TribalHeaddress</wornGraphicPath>
      <tags>
        <li>TSC_Crown</li>
      </tags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Single">
      <color>(255,214,120)</color>
    </colorGenerator>
    <comps>
      <li Class="TheShatteredCrown.CompProperties_TSC_Wish" />
    </comps>
    <statBases>
      <Mass>2</Mass>
      <MarketValue>15000</MarketValue>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
  </ThingDef>

</Defs>
