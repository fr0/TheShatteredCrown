  <!-- Haldor's stock: weapons, armor, and general goods, all medieval.
       He also BUYS what these generators handle (weapons/armor of the
       listed kinds) plus expensive simple goods. -->
  <TraderKindDef>
    <defName>TSC_Trader_Smith</defName>
    <label>village smith</label>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>400~700</countRange>
      </li>
      <li Class="StockGenerator_MultiDef">
        <thingDefs>
          <li>MeleeWeapon_LongSword</li>
          <li>MeleeWeapon_Gladius</li>
          <li>MeleeWeapon_Mace</li>
          <li>MeleeWeapon_Spear</li>
        </thingDefs>
        <countRange>3~5</countRange>
      </li>
      <li Class="StockGenerator_MultiDef">
        <thingDefs>
          <li>MeleeWeapon_Knife</li>
          <li>MeleeWeapon_Club</li>
        </thingDefs>
        <countRange>2~3</countRange>
      </li>
      <li Class="StockGenerator_MultiDef">
        <thingDefs>
          <li>Bow_Short</li>
          <li>Bow_Recurve</li>
          <li>Bow_Great</li>
        </thingDefs>
        <countRange>2~4</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Apparel_PlateArmor</thingDef>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Apparel_SimpleHelmet</thingDef>
        <countRange>2~3</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>TSC_Apparel_Gambeson</thingDef>
        <countRange>2~4</countRange>
      </li>
      <!-- Whatever else the load order calls medieval. With no armour mods
           this adds a little vanilla variety; with Medieval Overhaul the
           smith finally sells the arms the rest of the world is using.
           Named/legendary pieces are excluded by value (TSC_MedievalGear). -->
      <li Class="TheShatteredCrown.StockGenerator_TSC_MedievalGear">
        <weapons>true</weapons>
        <armor>false</armor>
        <countRange>3~6</countRange>
      </li>
      <li Class="TheShatteredCrown.StockGenerator_TSC_MedievalGear">
        <weapons>false</weapons>
        <armor>true</armor>
        <countRange>2~4</countRange>
      </li>
      <!-- Arrows and bolts, when a combat overhaul makes bows need them.
           Inert without one (TSC_Ammo). Covers the hand-listed bow
           generators above as well as the modded weapons below. -->
      <li Class="TheShatteredCrown.StockGenerator_TSC_Ammo">
        <countRange>1~1</countRange>
        <maxTypes>4</maxTypes>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Steel</thingDef>
        <countRange>75~150</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WoodLog</thingDef>
        <countRange>100~200</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cloth</thingDef>
        <countRange>60~120</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineHerbal</thingDef>
        <countRange>6~10</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Pemmican</thingDef>
        <countRange>50~100</countRange>
      </li>
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <!-- Willingness to buy every weapon and every piece of armour is
           enforced in code (Patch_SmithWillTrade), NOT with zero-count
           category generators: vanilla's category generator expects a
           price range alongside its def count, and a malformed one broke
           this whole trader kind - the smith stood at his anvil with
           nothing to trade. -->
    </stockGenerators>
  </TraderKindDef>


