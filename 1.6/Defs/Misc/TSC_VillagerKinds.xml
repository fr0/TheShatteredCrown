  <!-- Haldor's stock: weapons, armor, and general goods, all medieval.
       He also BUYS what these generators handle (weapons/armor of the
       listed kinds) plus expensive simple goods. -->
  <TraderKindDef>
    <defName>TSC_Trader_Smith</defName>
    <label>village smith</label>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>400~700</countRange>
      </li>
      <li Class="StockGenerator_MultiDef">
        <thingDefs>
          <li>MeleeWeapon_LongSword</li>
          <li>MeleeWeapon_Gladius</li>
          <li>MeleeWeapon_Mace</li>
          <li>MeleeWeapon_Spear</li>
        </thingDefs>
        <countRange>3~5</countRange>
      </li>
      <li Class="StockGenerator_MultiDef">
        <thingDefs>
          <li>MeleeWeapon_Knife</li>
          <li>MeleeWeapon_Club</li>
        </thingDefs>
        <countRange>2~3</countRange>
      </li>
      <li Class="StockGenerator_MultiDef">
        <thingDefs>
          <li>Bow_Short</li>
          <li>Bow_Recurve</li>
          <li>Bow_Great</li>
        </thingDefs>
        <countRange>2~4</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Apparel_PlateArmor</thingDef>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Apparel_SimpleHelmet</thingDef>
        <countRange>2~3</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>TSC_Apparel_Gambeson</thingDef>
        <countRange>2~4</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Steel</thingDef>
        <countRange>75~150</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WoodLog</thingDef>
        <countRange>100~200</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cloth</thingDef>
        <countRange>60~120</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineHerbal</thingDef>
        <countRange>6~10</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Pemmican</thingDef>
        <countRange>50~100</countRange>
      </li>
      <li Class="StockGenerator_BuyExpensiveSimple" />
    </stockGenerators>
  </TraderKindDef>

</Defs>
