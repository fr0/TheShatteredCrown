<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Harrowfield villagers: one kind per named resident so each
       carries their own DialogueExtension. Unarmed-ish civilians. -->

  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Villager_Tam</defName>
    <label>farmer</label>
    <combatPower>25</combatPower>
    <isFighter>false</isFighter>
    <invFoodDef>Pemmican</invFoodDef>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_Tam</dialogue>
      </li>
    </modExtensions>
  </PawnKindDef>

