  <!-- Ranger: Charged Shot (severity = shots remaining; consumed per projectile impact) -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_ChargedShot</defName>
    <label>charged shot</label>
    <description>Every draw is measured, every loose is meant. The next arrows fly truer and hit like judgment.</description>
    <!-- Severity = CHARGES here, not the scale factor: plain hediff class.
         The damage bonus scales with ranger level in the projectile patch. -->
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>3</initialSeverity>
    <maxSeverity>3</maxSeverity>
    <!-- The aim half of the buff. Vanilla resolves hit chance through
         ShootingAccuracyPawn (+6 here: careful shooter is +5, and this
         lasts three shots, not a lifetime). CE ignores this stat - its
         model is sway and spread - so the CE folder patches this stage
         with the CE stats instead (TSC_ChargedShotAim.xml). -->
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>6</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_ChargedArrow</mote>
        <offset>(-0.45, 0, 0.08)</offset>
      </li>
    </comps>
  </HediffDef>

  <!-- Paladin: Righteous Brand (attack-falter debuff; replaced the old +30% damage mark) -->
