  <!-- On a summoned creature: marks it conjured and shows the time left
       (turn-order chip). TSC_SummonTracker owns the actual lifetime. -->
  <HediffDef>
    <defName>TSC_Hediff_Summoned</defName>
    <label>summoned</label>
    <description>A conjured creature. When the magic fades, it vanishes - and if it is slain, nothing of it remains.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.85, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li />
    </stages>
  </HediffDef>


  <!-- The hard landing at the bottom of the well: a broken bone in one limb.
       Tendable; knits on its own in about a week. -->
  <HediffDef>
    <defName>TSC_Hediff_BrokenLimb</defName>
    <label>broken bone</label>
    <description>A cracked or broken bone from a hard fall. Painful and crippling for the limb until it knits, which takes a week or so. Tending eases it along.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.55, 0.35)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>36</baseTendDurationHours>
        <severityPerDayTended>-0.06</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.14</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <partEfficiencyOffset>-0.6</partEfficiencyOffset>
        <painOffset>0.25</painOffset>
      </li>
    </stages>
  </HediffDef>


  <!-- What centuries actually mean when the stick comes off the chair:
       applied by npc_hostile(TSC_Hediff_ElderBlood) if the player chooses
       to make Old Wick pay. -->
  <HediffDef>
    <defName>TSC_Hediff_ElderBlood</defName>
    <label>elder blood</label>
    <description>The strength of something very old that has stopped pretending to be tired.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <painFactor>0.15</painFactor>
        <statOffsets>
          <MeleeHitChance>6</MeleeHitChance>
          <MeleeDodgeChance>18</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
          <MoveSpeed>1.35</MoveSpeed>
          <MeleeDamageFactor>2.2</MeleeDamageFactor>
          <IncomingDamageFactor>0.6</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- The sleeper behind the warm door, on its feet with the ember bow.
       Elder blood is Old Wick's inheritance and reads as a swordsman's;
       this is the source of it, and it fights at range: it aims faster and
       truer than anything alive, moves like it is not carrying a body, and
       does not care what you put through it.
       Applied by MapComponent_TSC_ElderSleeper when the shard is lifted. -->
  <HediffDef>
    <defName>TSC_Hediff_KindledBlood</defName>
    <label>kindled blood</label>
    <description>The blood every other sanguophage is a copy of, awake for the first time in eight hundred years and holding a bow.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <painFactor>0.15</painFactor>
        <statOffsets>
          <ShootingAccuracyPawn>8</ShootingAccuracyPawn>
          <AimingDelayFactor>-0.35</AimingDelayFactor>
          <MeleeDodgeChance>12</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
          <MoveSpeed>1.25</MoveSpeed>
          <IncomingDamageFactor>0.6</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Reading beast sign done right (TSC_BeastTracks check spot): a few
       days of the hunter's eye against everything, because knowing one
       animal completely sharpens the eye for all of them. -->
  <HediffDef>
    <defName>TSC_Hediff_HuntersEye</defName>
    <label>hunter's eye</label>
    <description>The particular sharpness that follows reading a killing ground correctly: where weight lands, where things bolt, what a limp hides. It fades in a few days.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>3</ShootingAccuracyPawn>
          <MeleeDodgeChance>4</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- The wayside shrines' answer: a few days of steadiness for whoever
       speaks the rite correctly (TSC_ShrineAltar check spot). Deliberately
       modest - a traveler's favor, not a war blessing. -->
  <HediffDef>
    <defName>TSC_Hediff_Blessed</defName>
    <label>old rite's favor</label>
    <description>A steadiness behind the eyes, left by a rite spoken correctly at an old shrine. It fades in a few days, the way all borrowed things go back.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>240000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MeleeHitChance>2</MeleeHitChance>
          <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
          <MentalBreakThreshold>-0.04</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- The other answer: what a shrine leaves on a hand caught in the
       offering niche. Mirror of the blessing and half its strength - a
       bad feeling that fades, not a smiting. The theft not attempted
       costs nothing; the theft BOTCHED is remembered for a while. -->
  <HediffDef>
    <defName>TSC_Hediff_ShrineCurse</defName>
    <label>old rite's displeasure</label>
    <description>A wrongness behind the eyes, picked up reaching into a place that was watching. Nothing follows you. It just watches you go, and you can feel it doing it. It fades in a day or so.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MeleeHitChance>-1</MeleeHitChance>
          <ShootingAccuracyPawn>-1</ShootingAccuracyPawn>
          <MentalBreakThreshold>0.03</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- ================================================================
       The two marks and the two shouts used to share one hediff each,
       which made a rogue/ranger or a bard/barbarian multiclass carry two
       buttons that did exactly the same thing. Each pair is now split:
       the older hediff stays with one owner (so live saves keep working)
       and the other owner gets its own.
       ================================================================ -->

  <!-- Ranger: the long hunt. Weaker than the rogue's mark and four times
       the duration, with a slow so the quarry cannot simply leave. -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Hunted</defName>
    <label>hunted</label>
    <description>A ranger has settled on this one. It will not be lost in the trees, and it will not outrun what is following it.</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.7, 0.9, 0.4)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>14400</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_TargetMark</mote>
        <offset>(0, 0, 0.72)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>1.18</IncomingDamageFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- Bard: the dirge takes the aim, not the legs. A war cry frightens the
       body; a lament for people who are not dead yet gets into the head. -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Mourning</defName>
    <label>mourning</label>
    <description>Somebody is singing your funeral while you are around to listen.</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.55, 0.35, 0.75)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2400</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_TremorLines</mote>
        <offset>(-0.42, 0, 0.5)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>-0.15</ShootingAccuracyPawn>
          <MeleeHitChance>-0.15</MeleeHitChance>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- Monk: composure. The cleric cures other people; the monk steadies
       himself and gets back to work far sooner. -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_InnerCalm</defName>
    <label>inner calm</label>
    <description>Breath, then stillness, then everything else. Nothing here is urgent enough to hurry for.</description>
    <isBad>false</isBad>
    <defaultLabelColor>(0.85, 0.95, 1)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MentalBreakThreshold>-0.15</MentalBreakThreshold>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.10</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- The Bandit Baron's colors: a permanent overhead iron-crown mark so
       the man himself is unmistakable across a crowded hall. Applied by
       MapComponent_TSC_BaronParley the moment he is seen on a keep map,
       which also retrofits saves that generated him before this existed. -->
  <HediffDef>
    <defName>TSC_Hediff_BaronMark</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>the Bandit Baron</label>
    <description>Five years of banners, and every one of them answers to this man.</description>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <defaultLabelColor>(0.85, 0.4, 0.35)</defaultLabelColor>
    <comps>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_IronCrownMark</mote>
        <offset>(0, 0, 0.78)</offset>
      </li>
    </comps>
  </HediffDef>

  <!-- Cleric: Prayer of Mending. Wounds close on their own for half a
       minute; the regen comp reads severity as the caster's level factor,
       so a practiced cleric mends faster through the same prayer. -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Mending</defName>
    <label>mending</label>
    <description>The prayer stays in the flesh after the words end, drawing wounds closed a little at a time.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1800</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_Regen">
        <healPerPulse>2</healPerPulse>
        <pulseIntervalTicks>300</pulseIntervalTicks>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_MendCross</mote>
        <offset>(0, 0, 0.72)</offset>
      </li>
    </comps>
  </HediffDef>

  <!-- Sorcerer: Frost Nova's chill. Same half-speed idea as Leaden Curse
       but shorter - the nova buys distance, the curse wins duels. -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Chilled</defName>
    <label>chilled</label>
    <description>Cold in the joints and the blood. The legs answer late.</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.6, 0.8, 0.95)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1200</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_FrostFlake</mote>
        <offset>(0, 0, 0.72)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.5</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Monk: Serpent Stance. The monk's defense is not being where the
       blow lands. Dodge is the whole identity - no armor, no ward. -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_SerpentStance</defName>
    <label>serpent stance</label>
    <description>Weight low, hands open, never twice in the same place. The strike finds only where the monk was.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1800</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_SerpentCoil</mote>
        <offset>(0, 0, 0.72)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MeleeDodgeChance>18</MeleeDodgeChance>
          <MoveSpeed>0.3</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Enemy veterancy: the visible carrier for party-level stat scaling
       (TSC_EnemyScaling). Severity = the party's average level above the
       grace period when this enemy was first seen; the TakeDamage patch
       reads it for both directions. No stats here on purpose - one code
       path covers melee, ranged and explosions alike. -->
  <HediffDef>
    <defName>TSC_Hediff_Veteran</defName>
    <label>hardened</label>
    <description>Word of a capable company travels, and what survives on the roads these days has survived worse. This one takes less harm and deals more, in proportion to the reputation your party has earned.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>12</maxSeverity>
    <defaultLabelColor>(0.85, 0.45, 0.35)</defaultLabelColor>
  </HediffDef>


  <!-- Stealth: the movement price of a careful approach. The sight halving
       and the break rules live in TSC_Stealth.cs; this hediff exists to
       carry the penalty and mark the pawn as sneaking on screen. -->
  <HediffDef>
    <defName>TSC_Hediff_Stealth</defName>
    <label>sneaking</label>
    <description>Moving carefully and keeping to cover. Slow, and much harder to notice at a distance.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <maxSeverity>1</maxSeverity>
    <defaultLabelColor>(0.6, 0.7, 0.85)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_SneakHood</mote>
        <offset>(0.42, 0, 0.52)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.5</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>


  <!-- Pass Without Trace: the ranger's party-wide woodcraft. The stealth
       maths (TSC_Stealth) reads this hediff; the mote marks who has it. -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_PassWithoutTrace</defName>
    <label>passing without trace</label>
    <description>Moving the way the ranger showed: quiet ground, broken outlines, no tracks worth reading.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>36000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_SneakHood</mote>
        <offset>(-0.42, 0, 0.5)</offset>
      </li>
    </comps>
    <stages>
      <li />
    </stages>
  </HediffDef>

  <!-- Rogue: what Shadowstep leaves behind. Short on purpose - 300 ticks is
       one turn-based round, so it is a window to strike through and not a
       buff to walk around wearing. -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_OutOfTheDark</defName>
    <label>out of the dark</label>
    <description>Arrived where nobody was looking. The next few seconds are worth more than the ones before them.</description>
    <defaultLabelColor>(0.65, 0.6, 0.85)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_SneakHood</mote>
        <offset>(0.42, 0, 0.52)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MeleeHitChance>0.10</MeleeHitChance>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.40</MeleeDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
