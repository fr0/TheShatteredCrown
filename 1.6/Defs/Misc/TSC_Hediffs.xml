      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_TargetMark</mote>
        <offset>(0, 0, 0.72)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>1.30</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Wizard: Arcane Ward -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_ArcaneWard</defName>
    <label>arcane ward</label>
