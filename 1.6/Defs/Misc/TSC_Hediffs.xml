    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>7200</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_WardRune</mote>
        <offset>(0, 0, 0.72)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>0.50</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Wizard: Leaden Curse -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Leaden</defName>
    <label>leaden</label>
    <description>Limbs like poured lead. Everything is slow and far away.</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.9, 0.5, 0.4)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2700</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_LeadWeight</mote>
        <offset>(0.45, 0, 0.08)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.5</MoveSpeed>
        </statFactors>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- Barbarian: Rage -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Rage</defName>
    <label>raging</label>
    <description>Fury with a heartbeat. Hits harder, feels less, aims worse.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_RageFlame</mote>
        <offset>(0.45, 0, 0.08)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.5</painFactor>
        <statFactors>
          <MeleeDamageFactor>1.30</MeleeDamageFactor>
        </statFactors>
        <statOffsets>
          <ShootingAccuracyPawn>-4</ShootingAccuracyPawn>
          <MoveSpeed>0.3</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Barbarian: Unbreakable -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Unbreakable</defName>
    <label>unbreakable</label>
    <description>Too stubborn to fall. Pain is a rumor; wounds are a later problem.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2400</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_AnvilMark</mote>
        <offset>(-0.45, 0, 0.08)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.1</painFactor>
        <statFactors>
          <IncomingDamageFactor>0.75</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Druid: Bramble Snare -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Snared</defName>
    <label>snared</label>
    <description>Brambles from nowhere, with opinions about leaving.</description>
    <isBad>true</isBad>
    <defaultLabelColor>(0.9, 0.5, 0.4)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1800</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_ThornSnare</mote>
        <offset>(0, 0, -0.28)</offset>
        <rotationRate>20</rotationRate>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.15</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Druid: Barkskin -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Barkskin</defName>
    <label>barkskin</label>
    <description>Skin like old oak. Cuts land shallow.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>7200</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <!-- The wreath: a slow-spinning ring of leaves around the warded. -->
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_BarkWreath</mote>
        <rotationRate>35</rotationRate>
      </li>
    </comps>
    <stages>
      <li>
        <!-- Single-target premium (was +25/+15 as an area buff) -->
        <statOffsets>
          <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Monk: Flurry -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Flurry</defName>
    <label>flurry</label>
    <description>Stillness spent; speed purchased. Strikes come like rain.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2400</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_FlurryChevrons</mote>
        <offset>(0.45, 0, 0.08)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MeleeCooldownFactor>0.6</MeleeCooldownFactor>
        </statFactors>
        <statOffsets>
          <MeleeDodgeChance>10</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Paladin: Aura of Courage -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Courage</defName>
    <label>heartened</label>
    <description>A paladin's certainty is contagious. Fear finds no purchase.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MentalBreakThreshold>-0.12</MentalBreakThreshold>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- Performance cooldown marker (fireside tales) -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Performed</defName>
    <label>performed recently</label>
    <description>Told a tale by the fire not long ago. Even the best voice needs new material.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
  </HediffDef>

  <!-- Ranger: Swift Quiver -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_SwiftQuiver</defName>
    <label>swift quiver</label>
    <description>The bow becomes a heartbeat: draw, loose, draw.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_QuiverArrow</mote>
        <offset>(0.45, 0, 0.08)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <RangedCooldownFactor>0.65</RangedCooldownFactor>
        </statFactors>
        <statOffsets>
          <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Warden: Charge (5-second sprint; GiveHediff expiry comes from Ability_Duration) -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_Charge</defName>
    <label>charging</label>
    <description>Legs remember the wall-sprints of the old watch. Briefly, nothing on two feet is faster.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_ChargeChevrons</mote>
        <offset>(0, 0, 0.72)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>5</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Ranger: Charged Shot (severity = shots remaining; consumed per projectile impact) -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_ChargedShot</defName>
    <label>charged shot</label>
    <description>Every draw is measured, every loose is meant. The next arrows hit like judgment.</description>
    <!-- Severity = CHARGES here, not the scale factor: plain hediff class.
         The damage bonus scales with ranger level in the projectile patch. -->
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>3</initialSeverity>
    <maxSeverity>3</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_ChargedArrow</mote>
        <offset>(-0.45, 0, 0.08)</offset>
      </li>
    </comps>
  </HediffDef>

  <!-- Paladin: Righteous Brand (attack-falter debuff; replaced the old +30% damage mark) -->
  <HediffDef ParentName="TSC_TimedBuffBase">
    <defName>TSC_Hediff_RighteousBrand</defName>
    <label>branded</label>
    <description>Named for what it is, the branded thing fights like something that knows it is beaten.</description>
    <isBad>true</isBad>
    <defaultLabelColor>(1, 0.8, 0.4)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TheShatteredCrown.HediffCompProperties_TSC_AttachedOverlay">
        <mote>TSC_Mote_BrandFlame</mote>
        <offset>(-0.45, 0, 0.08)</offset>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MeleeHitChance>-4</MeleeHitChance>
          <ShootingAccuracyPawn>-4</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>


  <!-- On a summoned creature: marks it conjured and shows the time left
       (turn-order chip). TSC_SummonTracker owns the actual lifetime. -->
  <HediffDef>
    <defName>TSC_Hediff_Summoned</defName>
    <label>summoned</label>
    <description>A conjured creature. When the magic fades, it vanishes - and if it is slain, nothing of it remains.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.85, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li />
    </stages>
  </HediffDef>


  <!-- The hard landing at the bottom of the well: a broken bone in one limb.
       Tendable; knits on its own in about a week. -->
  <HediffDef>
    <defName>TSC_Hediff_BrokenLimb</defName>
    <label>broken bone</label>
    <description>A cracked or broken bone from a hard fall. Painful and crippling for the limb until it knits, which takes a week or so. Tending eases it along.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.55, 0.35)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>36</baseTendDurationHours>
        <severityPerDayTended>-0.06</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.14</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <partEfficiencyOffset>-0.6</partEfficiencyOffset>
        <painOffset>0.25</painOffset>
      </li>
    </stages>
  </HediffDef>


  <!-- What centuries actually mean when the stick comes off the chair:
       applied by npc_hostile(TSC_Hediff_ElderBlood) if the player chooses
       to make Old Wick pay. -->
  <HediffDef>
    <defName>TSC_Hediff_ElderBlood</defName>
    <label>elder blood</label>
    <description>The strength of something very old that has stopped pretending to be tired.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <painFactor>0.15</painFactor>
        <statOffsets>
          <MeleeHitChance>6</MeleeHitChance>
          <MeleeDodgeChance>18</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
          <MoveSpeed>1.35</MoveSpeed>
          <MeleeDamageFactor>2.2</MeleeDamageFactor>
          <IncomingDamageFactor>0.6</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- The sleeper behind the warm door, on its feet with the ember bow.
       Elder blood is Old Wick's inheritance and reads as a swordsman's;
       this is the source of it, and it fights at range: it aims faster and
       truer than anything alive, moves like it is not carrying a body, and
       does not care what you put through it.
       Applied by MapComponent_TSC_ElderSleeper when the shard is lifted. -->
  <HediffDef>
    <defName>TSC_Hediff_KindledBlood</defName>
    <label>kindled blood</label>
    <description>The blood every other sanguophage is a copy of, awake for the first time in eight hundred years and holding a bow.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <painFactor>0.15</painFactor>
        <statOffsets>
          <ShootingAccuracyPawn>8</ShootingAccuracyPawn>
          <AimingDelayFactor>-0.35</AimingDelayFactor>
          <MeleeDodgeChance>12</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
