<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Party banter triggers. The WORDS live in Dialogues/banter_*.agd like
       every other conversation; these defs only say who must be riding
       together, what must be true, and which dialogue opens. Each fires
       once per save (the conversation window cannot be missed), on a map
       or on the road alike. speakers[0] is the window's npc. -->

  <TheShatteredCrown.TSC_BanterDef>
    <defName>TSC_Banter_Gerald</defName>
    <speakers><li>TSC_Npc_Bard</li><li>TSC_Npc_Bran</li></speakers>
    <dialogue>TSC_Banter_Gerald</dialogue>
  </TheShatteredCrown.TSC_BanterDef>

  <TheShatteredCrown.TSC_BanterDef>
    <defName>TSC_Banter_WrenArmor</defName>
    <speakers><li>TSC_Npc_Bran</li><li>TSC_Npc_Bard</li></speakers>
    <dialogue>TSC_Banter_WrenArmor</dialogue>
  </TheShatteredCrown.TSC_BanterDef>

  <TheShatteredCrown.TSC_BanterDef>
    <defName>TSC_Banter_RhymeAshvale</defName>
    <speakers><li>TSC_Npc_Bard</li><li>TSC_Npc_Maewyn</li></speakers>
    <dialogue>TSC_Banter_RhymeAshvale</dialogue>
  </TheShatteredCrown.TSC_BanterDef>

  <TheShatteredCrown.TSC_BanterDef>
