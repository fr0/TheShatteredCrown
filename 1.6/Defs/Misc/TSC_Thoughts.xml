<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- The company's mood after finishing one of this mod's quests.
       baseMoodEffect is 0 in the def on purpose: the real value comes from
       the mod setting ("Mood bonus on quest completion", default 0 = off)
       and is written into this stage at startup and whenever the setting
       changes. A def value here would be a second, silent source of truth. -->
  <ThoughtDef>
    <defName>TSC_Thought_QuestComplete</defName>
    <durationDays>2</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.6</stackedEffectMultiplier>
    <stages>
      <li>
        <label>quest finished</label>
        <description>We took a quest and we saw it through. That is not nothing, out here.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>


  <!-- The temple's healing, felt from the inside: wounds that would have
       ached for a week close in an afternoon. -->
  <ThoughtDef>
    <defName>TSC_Thought_TempleHealed</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>mended at the temple</label>
        <description>My wounds closed under the priest's hands, and the ache went with them. It is a strange, light feeling to be whole again so quickly.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>


  <!-- A night at the tavern: hot food, a bench, and enough noise that
       nobody has to think. -->
  <ThoughtDef>
    <defName>TSC_Thought_TavernNight</defName>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>a night at the tavern</label>
        <description>Hot food, a bench by the fire, and an argument about nothing that went on until the candles burned down. The road can wait until morning.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Both ship at 0 and are driven entirely from the mod settings
       (TSC_MoodOptions.ApplySettings), for the same reason the quest
       thought is: a value here would be a second, silent source of truth. -->

  <!-- The permanent one. Situational, not a memory: it is a fact about
       who these people are, not something that happened to them. -->
  <ThoughtDef>
    <defName>TSC_Thought_AdventuringLife</defName>
    <workerClass>TheShatteredCrown.ThoughtWorker_TSC_AdventuringLife</workerClass>
    <stages>
      <li>
        <label>adventuring life</label>
        <description>No fields to weed, no roof to patch, nobody's ledger to answer to. Whatever else the road costs, it was chosen.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- The per-kill one. A memory, and it STACKS: a hard fight should feel
       like a hard fight afterward. -->
  <ThoughtDef>
    <defName>TSC_Thought_Bloodied</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>20</stackLimit>
    <stackedEffectMultiplier>1</stackedEffectMultiplier>
    <stages>
      <li>
        <label>won a fight</label>
        <description>Somebody came at the company and did not walk away from it. That is worth something, and it is worth more the more of them there were.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
