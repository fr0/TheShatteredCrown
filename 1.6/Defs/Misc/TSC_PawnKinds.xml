<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Act 1: the Wayfarer party -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Wayfarer_Serra</defName>
    <label>wayfarer captain</label>
    <combatPower>90</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>true</isFighter>
    <weaponTags Inherit="False">
      <li>NeolithicRangedHeavy</li>
    </weaponTags>
    <weaponMoney>200~400</weaponMoney>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_Serra</dialogue>
      <initiations>
          <li>
            <!-- The door swings both ways: a companion who has gone cold on
                 this company asks to be let go. RECURRING (once=false): a
                 stay bought with persuasion while the affinity underneath is
                 still cold gets asked for again - and the roll is per_npc
                 once per companion, so the second ask has no talking left in
                 it. Suppressed while a departure is already announced and
                 waiting for walkable ground (Dialogues/part_ways_ask.agd). -->
            <dialogue>TSC_Dialogue_PartWaysAsk</dialogue>
            <mtbDays>4</mtbDays>
            <once>false</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_Affinity">
                <max>-1</max>
              </li>
              <li Class="TheShatteredCrown.DialogueCondition_NotPendingDeparture" />
            </conditions>
          </li>
        </initiations>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Wayfarer_Oswin</defName>
    <label>wayfarer scholar</label>
    <combatPower>40</combatPower>
    <isFighter>false</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_Oswin</dialogue>
      <initiations>
          <li>
            <!-- The door swings both ways: a companion who has gone cold on
                 this company asks to be let go. RECURRING (once=false): a
                 stay bought with persuasion while the affinity underneath is
                 still cold gets asked for again - and the roll is per_npc
                 once per companion, so the second ask has no talking left in
                 it. Suppressed while a departure is already announced and
                 waiting for walkable ground (Dialogues/part_ways_ask.agd). -->
            <dialogue>TSC_Dialogue_PartWaysAsk</dialogue>
            <mtbDays>4</mtbDays>
            <once>false</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_Affinity">
                <max>-1</max>
              </li>
              <li Class="TheShatteredCrown.DialogueCondition_NotPendingDeparture" />
            </conditions>
          </li>
        </initiations>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- Act 1: Maewyn the druid (recruitable) -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Companion_Maewyn</defName>
    <label>druid</label>
    <combatPower>70</combatPower>
    <isFighter>false</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_Maewyn</dialogue>
        <initiations>
          <li>
            <!-- The door swings both ways: a companion who has gone cold on
                 this company asks to be let go. RECURRING (once=false): a
                 stay bought with persuasion while the affinity underneath is
                 still cold gets asked for again - and the roll is per_npc
                 once per companion, so the second ask has no talking left in
                 it. Suppressed while a departure is already announced and
                 waiting for walkable ground (Dialogues/part_ways_ask.agd). -->
            <dialogue>TSC_Dialogue_PartWaysAsk</dialogue>
            <mtbDays>4</mtbDays>
            <once>false</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_Affinity">
                <max>-1</max>
              </li>
              <li Class="TheShatteredCrown.DialogueCondition_NotPendingDeparture" />
            </conditions>
          </li>
          <!-- Maewyn seeks the player out on the road and offers the Druid's teaching -->
          <li>
            <!-- Her companion quest. Late, and gated on affinity: the state
                 of her grove is not a thing she raises with people she is
                 merely working for. -->
            <dialogue>TSC_Dialogue_MaewynRaven</dialogue>
            <mtbDays>2</mtbDays>
            <once>true</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_Affinity">
                <min>15</min>
              </li>
            </conditions>
          </li>
          <li>
            <dialogue>TSC_Dialogue_Maewyn_RoadTalk</dialogue>
            <mtbDays>1</mtbDays>
            <once>true</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
            </conditions>
          </li>
        </initiations>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- Companion: Bran Underhill, scout of the missing party. His own kind so his
       dialogue tree attaches to him alone. -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Companion_Bran</defName>
    <label>watchman</label>
    <combatPower>80</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>true</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeAdvanced</li>
    </weaponTags>
    <weaponMoney>200~400</weaponMoney>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_Bran</dialogue>
        <initiations>
          <li>
            <!-- The door swings both ways: a companion who has gone cold on
                 this company asks to be let go. RECURRING (once=false): a
                 stay bought with persuasion while the affinity underneath is
                 still cold gets asked for again - and the roll is per_npc
                 once per companion, so the second ask has no talking left in
                 it. Suppressed while a departure is already announced and
                 waiting for walkable ground (Dialogues/part_ways_ask.agd). -->
            <dialogue>TSC_Dialogue_PartWaysAsk</dialogue>
            <mtbDays>4</mtbDays>
            <once>false</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_Affinity">
                <max>-1</max>
              </li>
              <li Class="TheShatteredCrown.DialogueCondition_NotPendingDeparture" />
            </conditions>
          </li>
          <!-- Bram seeks the player out about a day after joining -->
          <li>
            <!-- And the telling, once he has decided to do it. He picks the
                 moment himself: late, fire low, three of them awake. Serra
                 has to still be with the company: the flag can be set and
                 then she dies or leaves before the mtb fires, and this is
                 not a scene that works played to her empty bedroll. -->
            <dialogue>TSC_Dialogue_BranSerra</dialogue>
            <mtbDays>0.5</mtbDays>
            <once>true</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_InParty">
                <npc>TSC_Npc_Serra</npc>
              </li>
              <li Class="TheShatteredCrown.DialogueCondition_FlagSet">
                <flag>TSC_BranSerraPending</flag>
              </li>
            </conditions>
          </li>
          <li>
            <!-- His companion quest. Held back until he has confided in the
                 company once already (TSC_BranConfided): he does not open
                 with the worst thing he has done. -->
            <dialogue>TSC_Dialogue_BranDoor</dialogue>
            <mtbDays>1.5</mtbDays>
            <once>true</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_FlagSet">
                <flag>TSC_BranConfided</flag>
              </li>
            </conditions>
          </li>
          <li>
            <dialogue>TSC_Dialogue_Bran_CampTalk</dialogue>
            <mtbDays>1</mtbDays>
            <once>true</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
            </conditions>
          </li>
        </initiations>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- The crownless: medieval bandit kinds for TSC_Faction_Bandits. -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Bandit_Brigand</defName>
    <label>brigand</label>
    <combatPower>55</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>true</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
      <li>MedievalMeleeAdvanced</li>
    </weaponTags>
    <weaponMoney>80~250</weaponMoney>
  </PawnKindDef>

  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Bandit_Archer</defName>
    <label>bandit archer</label>
    <combatPower>65</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>true</isFighter>
    <weaponTags Inherit="False">
      <li>NeolithicRangedBasic</li>
      <li>NeolithicRangedHeavy</li>
    </weaponTags>
    <weaponMoney>100~300</weaponMoney>
  </PawnKindDef>

  <!-- Enemy caster: a bandit who found "The Loud Blood" and read too much of
       it. Spawns with Sorcerer 3 (class seeded via TSC_ClassExtension +
       PawnGenerator postfix); the caster AI uses the aiCanUse spells
       (Scorch; Arc Lightning stays player-only for now). -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_BanditHexer</defName>
    <label>bandit hexer</label>
    <combatPower>140</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>true</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <weaponMoney>60~150</weaponMoney>
    <modExtensions>
      <li Class="TheShatteredCrown.TSC_ClassExtension">
        <classDef>TSC_Class_Sorcerer</classDef>
        <levels>3</levels>
      </li>
    </modExtensions>
  </PawnKindDef>


  <!-- Enemy support caster: the crew's bone-rattler. Cleric 3 seeded via
       TSC_ClassExtension; the caster AI aims his kit at his OWN side
       (TSC_AiCastHint): Healing Touch on the most-hurt brigand, Blessing
       on whoever lacks one. Kill the shaman first or fight uphill. -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_BanditShaman</defName>
    <label>bandit shaman</label>
    <combatPower>110</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>true</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <weaponMoney>60~150</weaponMoney>
    <modExtensions>
      <li Class="TheShatteredCrown.TSC_ClassExtension">
        <classDef>TSC_Class_Cleric</classDef>
        <levels>3</levels>
      </li>
    </modExtensions>
  </PawnKindDef>


  <!-- Captain of the crypt looting party (surface parley; factionless until
       the words run out - see MapComponent_TSC_CryptParley). -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Bandit_CryptLeader</defName>
    <label>bandit captain</label>
    <combatPower>90</combatPower>
    <itemQuality>Good</itemQuality>
    <isFighter>true</isFighter>
    <weaponTags Inherit="False">
      <li>MedievalMeleeAdvanced</li>
    </weaponTags>
    <weaponMoney>250~450</weaponMoney>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_CryptBandits</dialogue>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- The bard of the distant city (Act 2 opening): unarmed performer,
       spawned at the lead's settlement by TSC_Act2_BardLead. -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_Bard</defName>
    <label>bard</label>
    <combatPower>30</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>false</isFighter>
    <weaponTags Inherit="False" />
    <weaponMoney>0</weaponMoney>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_Bard</dialogue>
        <initiations>
          <li>
            <!-- The door swings both ways: a companion who has gone cold on
                 this company asks to be let go. RECURRING (once=false): a
                 stay bought with persuasion while the affinity underneath is
                 still cold gets asked for again - and the roll is per_npc
                 once per companion, so the second ask has no talking left in
                 it. Suppressed while a departure is already announced and
                 waiting for walkable ground (Dialogues/part_ways_ask.agd). -->
            <dialogue>TSC_Dialogue_PartWaysAsk</dialogue>
            <mtbDays>4</mtbDays>
            <once>false</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_Affinity">
                <max>-1</max>
              </li>
              <li Class="TheShatteredCrown.DialogueCondition_NotPendingDeparture" />
            </conditions>
          </li>
          <!-- Her companion quest. She raises it herself once Act 4 has
               opened, because the answer is written down in the house the
               party is on its way to, and she is not going to mention six
               years of dread to people she has just met. -->
          <li>
            <dialogue>TSC_Dialogue_WrenVerse</dialogue>
            <mtbDays>1</mtbDays>
            <once>true</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_FlagSet">
                <flag>TSC_Act4CardShown</flag>
              </li>
              <!-- "I have never told anybody this, because in a tavern it is
                   a good story and out here it is not." She tells people she
                   trusts, not people she travels with. -->
              <li Class="TheShatteredCrown.DialogueCondition_Affinity">
                <min>15</min>
              </li>
            </conditions>
          </li>
          <!-- The last four bars, almost. Once the regalia is gathered and
               her own question is settled, she notices the ending getting
               close - the road's end she has been waiting to stand at is
               now a place with a name on the map. -->
          <li>
            <dialogue>TSC_Dialogue_WrenBars</dialogue>
            <mtbDays>0.5</mtbDays>
            <once>true</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_FlagSet">
                <flag>TSC_RegaliaGathered</flag>
              </li>
              <li Class="TheShatteredCrown.DialogueCondition_FlagSet">
                <flag>TSC_WrenLay</flag>
              </li>
            </conditions>
          </li>
          <!-- And she comes back to it once the songbook has been read.
               ALSO gated on her having asked (TSC_WrenVerseAsked): the
               songbook spawns at the monastery unconditionally, so without
               this the party could hand her the answer to a question she
               has not asked yet and the scenes would play in reverse. -->
          <li>
            <dialogue>TSC_Dialogue_WrenVerse2</dialogue>
            <mtbDays>0.5</mtbDays>
            <once>true</once>
            <conditions>
              <li Class="TheShatteredCrown.DialogueCondition_InParty" />
              <li Class="TheShatteredCrown.DialogueCondition_FlagSet">
                <flag>TSC_WrenVerseAsked</flag>
              </li>
              <li Class="TheShatteredCrown.DialogueCondition_FlagSet">
                <flag>TSC_WrenSongbook</flag>
              </li>
            </conditions>
          </li>
        </initiations>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- The guild's factor: one per friendly town in Adventure Mode
       (MapComponent_TSC_GuildFactor). Unarmed clerk; the dialogue is the
       whole job - the board, hirelings, and the rates haggle. -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_GuildFactor</defName>
    <label>guild factor</label>
    <combatPower>30</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>false</isFighter>
    <weaponTags Inherit="False" />
    <weaponMoney>0</weaponMoney>
    <modExtensions>
      <li Class="TheShatteredCrown.DialogueExtension">
        <dialogue>TSC_Dialogue_GuildFactor</dialogue>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- The one who made Old Wick: buried behind the warm door with the crown
       shard it was left to keep. Sleeps until the shard is lifted, then
       fights at range with TSC_Hediff_KindledBlood on (see MapComponent_TSC_ElderSleeper).
       Act 1's boss - the combat power is the wake-up, not the kind. -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>TSC_ElderSanguophage</defName>
    <label>the sleeper</label>
    <combatPower>400</combatPower>
    <itemQuality>Excellent</itemQuality>
    <isFighter>true</isFighter>
    <destroyGearOnDrop>false</destroyGearOnDrop>
    <!-- No rolled weapon: the ember bow is put in its hands at spawn
         (GenStep_TSC_CryptInterior.EquipEmberBow) and drops as loot. -->
    <weaponTags Inherit="False" />
    <weaponMoney>0</weaponMoney>
    <apparelMoney>400~700</apparelMoney>
    <apparelTags Inherit="False">
      <li>Medieval</li>
    </apparelTags>
  </PawnKindDef>

</Defs>
