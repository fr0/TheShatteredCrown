<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Buff overlay motes: persistent icons attached to a buffed pawn for the
       hediff's duration (HediffComp_TSC_AttachedOverlay). Long solidTime on
       purpose - lifetime is managed by the comp, not the clock. -->

  <ThingDef ParentName="MoteBase">
    <defName>TSC_Mote_BarkWreath</defName>
    <thingClass>TheShatteredCrown.TSC_MoteSpinAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.4</fadeInTime>
      <solidTime>99999</solidTime>
      <fadeOutTime>0.5</fadeOutTime>
    </mote>
    <graphicData>
      <texPath>Things/Mote/TSC_BarkWreath</texPath>
      <shaderType>Mote</shaderType>
      <drawSize>1.55</drawSize>
    </graphicData>
  </ThingDef>

