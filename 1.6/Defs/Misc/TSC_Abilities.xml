    <cooldownTicksRange>15000</cooldownTicksRange>
    <verbProperties>
      <warmupTime>1.5</warmupTime>
      <range>3.9</range>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetAnimals>true</canTargetAnimals>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="TheShatteredCrown.CompProperties_TSC_EnergyCost">
        <cost>10</cost>
      </li>
      <li Class="TheShatteredCrown.CompProperties_TSC_Heal">
