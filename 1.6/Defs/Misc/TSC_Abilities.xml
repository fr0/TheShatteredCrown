<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Class abilities. Plain cooldown-based abilities (no psylink/psyfocus) so
       they fit the medieval fiction; icons reuse Royalty's ability art. -->

  <AbilityDef Name="TSC_AbilityBase" Abstract="True">
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <writeCombatLog>true</writeCombatLog>
    <aiCanUse>false</aiCanUse>
    <!-- Without an explicit verb class the game tries to instantiate the
         abstract Verse.Verb and every ability breaks at gain time. Inherited
         (merged) into every child's verbProperties. -->
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
    </verbProperties>
  </AbilityDef>

