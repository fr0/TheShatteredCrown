<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Hidden, permanently hostile medieval bandit faction: the crownless.
       Owns the mod's hostile quest sites so their defenders generate ONLY
       from medieval pawn kinds (brigand / archer / hexer) - never guns.
       No settlements, no diplomacy, no world map presence. -->
  <FactionDef>
    <defName>TSC_Faction_Bandits</defName>
    <label>crownless bandits</label>
    <description>Deserters, outlaws, and the simply unlucky, living knife-first in the dead kingdom's margins. They keep the old roads dangerous.</description>
    <pawnSingular>bandit</pawnSingular>
    <pawnsPlural>bandits</pawnsPlural>
    <!-- REQUIRED: FactionGenerator name-rolls any faction without a
         fixedName, and with no factionNameMaker either that is an NRE -
         which crashed this faction OUT OF WORLD GENERATION silently (worlds
         had no bandit faction at all) and later crashed the find-or-create
         path visibly. Every vanilla hidden faction sets fixedName. -->
    <fixedName>The Crownless</fixedName>
    <categoryTag>Pirate</categoryTag>
    <techLevel>Medieval</techLevel>
    <hidden>true</hidden>
    <permanentEnemy>true</permanentEnemy>
    <humanlikeFaction>true</humanlikeFaction>
    <autoFlee>true</autoFlee>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>0</maxConfigurableAtWorldCreation>
    <basicMemberKind>TSC_Bandit_Brigand</basicMemberKind>
    <factionIconPath>World/WorldObjects/Expanding/Sites/AncientComplex</factionIconPath>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <!-- "Raider" is not a real spawn category (zero backstories carry it;
         it error-logged on EVERY bandit generated and fell back to random).
         Vanilla outlaws use Pirate; Tribal mixes in low-tech flavor. -->
    <backstoryFilters>
      <li>
        <categories>
          <li>Pirate</li>
          <li>Tribal</li>
        </categories>
      </li>
    </backstoryFilters>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0, 35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <raidLootValueFromPointsCurve>
      <points>
        <li>(35, 15)</li>
        <li>(700, 120)</li>
        <li>(2000, 250)</li>
      </points>
    </raidLootValueFromPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <TSC_Bandit_Brigand>10</TSC_Bandit_Brigand>
          <TSC_Bandit_Archer>7</TSC_Bandit_Archer>
          <TSC_BanditHexer>3</TSC_BanditHexer>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <TSC_Bandit_Brigand>10</TSC_Bandit_Brigand>
          <TSC_Bandit_Archer>7</TSC_Bandit_Archer>
          <TSC_BanditHexer>3</TSC_BanditHexer>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <TSC_Bandit_Brigand>10</TSC_Bandit_Brigand>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

</Defs>
